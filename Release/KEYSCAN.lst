  1599 0000F462                     keyscan:    .SECTION
  1600                              ;F_InitialKeyBorad:
  1601                              ;_F_InitialKeyBorad:
  1602                              ;			LDA			#00H
  1603                              ;;			STA			R_KeyState
  1604                              ;			STA			R_KeyTemp
  1605                              ;			STA			R_KeyValue
  1606                              ;			STA			R_DebounceCnt
  1607                              ;			STA			R_LongKeyTime
  1608                              ;F_PE12_Input:			
  1609                              ;			LDA		#00000000b
  1610                              ;			STA		P_IO_PortB_Dir
  1611                              ;			LDA		#00000000b
  1612                              ;			STA		P_IO_PortB_Attrib
  1613                              ;			LDA		#00000000b
  1614                              ;			STA		P_IO_PortB_Data			
  1615                              ;			RTS
