  3334                              ; ;;低电检测 
  3335                              ; ;=========================================================== 
  3336                              ; F_DC_Det: 	 	 	 	 ;DC检测 	 ;低电压检测 
  3337                              ; _F_DC_Det:			
  3338                              ; 	 	 	 %btst 	 R_Charge,D_Charge,?ExitDet 	 ;在充电退出低电检测 
  3339                              ; 	 	 	 LDA 	 	 R_LVDStatus 
  3340                              ; 	 	 	 CMP 	 	 #D_BatLevel1 
  3341                              ; 	 	 	 BEQ 	 	 ?Judge3V3      ;检测是否低于3.3V
  3342                              ; 	 	 	 CMP 	 	 #D_BatLevel2 
  3343                              ; 	 	 	 BEQ 	 	 ?Judge3V0      ;检测是否低于3.0V
  3344                              ; 	 	 	 CMP 	 	 #D_BatLevel3 
  3345                              ; 	 	 	 BEQ 	 	 ?Judge2V4      ;检测是否低于2.4V
  3346                              ; 	 ?ExitDet: 
  3347                              ; 	 	 	 RTS 
  3348                              ;
  3349                              ; 	 ?Judge3V3: ;新增3.3V检测
  3350                              ; 	 	 	 LDA 	 	 P_LVD_Ctrl 
  3351                              ; 	 	 	 AND 	 	 #D_LVDStatus 
  3352                              ; 	 	 	 BEQ 	 	 ?Exit3V3 
  3353                              ; 	 	 	 INC 	 	 R_DetCnt 
  3354                              ; 	 	 	 LDA 	 	 R_DetCnt 
  3355                              ; 	 	 	 CMP 	 	 #5 
  3356                              ; 	 	 	 BCC 	 	 ?ExitDet 
  3357                              ; 	 	 	 LDA 	 	 #D_BatLevel2 
