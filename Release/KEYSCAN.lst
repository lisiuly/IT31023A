  1617                              ; MACRO name	: %NeedKeyScan
  1618                              ; Purpose		:  DEbounceing? 
  1619                              ; Parameter		: next 
  1620                              ; Return		: none
  1621                              ; Destroy		: none 
  1622                              ; Stack depth	: none
  1623                              ; =============================================
  1624                              %NeedKeyScan	.MACRO	NotNeed		
  1625                              			LDA		R_KeyState
  1626                              			AND		#D_Debounce
  1627                              			BEQ		?L_Need#
  1628                              			
  1629                              			LDA		R_KeyScanInterval
  1630                              			BNE		NotNeed
  1631                              ?L_Need#:	
  1632                              			.ENDM
