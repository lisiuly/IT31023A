  1836 0000F541 F0 18               		BEQ		?BackLED_Set1
  1837                              		; 其他非法值统一设为1
  1838 0000F543 A9 01               		LDA		#1
  1839 0000F545 8D C0 02            		STA		_R_BacklightLevel
  1840 0000F548 4C 60 F5            		JMP		?BackLED_Done
  1841 0000F54B                     ?BackLED_Set2:
