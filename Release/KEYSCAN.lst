  3170                              ;;------------------------------------------
  3171                              ;; 函数：F_OpenData
  3172                              ;; 功能：I2C读取温度传感器数据 → 计算摄氏度 → 阈值判断 → 数据打包
  3173                              ;; 入口：无
  3174                              ;; 出口：R_DispTemper=打包温度；R_SpecFlag=状态标志
  3175                              ;;------------------------------------------
  3176                              ;F_OpenData:
  3177                              ;_F_OpenData:
  3178                              ;        ; 1. I2C写命令：读取温度传感器
  3179                              ;        LDX  #F6H        ; 传感器读取命令（根据你的传感器调整）
  3180                              ;        LDA  #00H         ; 寄存器地址
  3181                              ;        JSR  F_I2C_WriteData
  3182                              ;        
  3183                              ;        ; 2. 延时10ms等待数据就绪
  3184                              ; ;       JSR  F_Delay10ms
  3185                              ; 		LDA	 #2
  3186                              ; 		STA  R_DelayTemp
  3187                              ;        ; 3. I2C读取6字节原始数据到R_SaveData
  3188                              ; 		RTS
  3189                              ; 
  3190                              ;F_DelayReadyData:
  3191                              ;_F_DelayReadyData:
  3192                              ;		%btsf R_SpecFlag,D_DelayReady,?L_Exit
  3193                              ;        LDA  #00H
  3194                              ;        JSR  F_I2C_ReadData
  3195                              ;        %bitr R_SpecFlag,D_DelayReady
  3196                              ;        	%bits	RB_Lcd_Updata_Flag,D_LcdUpdate	
  3197                              ; 		 ; 步骤2：初始化状态标志（先清零）
  3198                              ;		LDA  #00H
  3199                              ;		STA  R_SpecFlag           	
  3200                              ;        ; 4. 计算摄氏度（核心）
  3201                              ;        JSR  F_CalculTempC
  3202                              ; 		JSR		F_CalculHum
  3203                              ; 		
  3204                              ;;		%bits	R_TimeStatus,AddOthers  
  3205                              ; 	?L_Exit:
  3206                              ;        RTS
  3207                              ;
  3208                              ;;湿度计算
  3209                              ;F_CalculHum:
  3210                              ;			;调用输入CNT4，CNT5
  3211                              ;			LDA		R_SaveData+3
  3212                              ;			STA		CNT4
  3213                              ;			LDA		R_SaveData+4
  3214                              ;			STA		CNT5
  3215                              ;			JSR	CAL_IC_HUM
  3216                              ;			LDX	#00
  3217                              ;			LDA	HUM
  3218                              ;			JSR	F_CAL_HEX_BCD2
  3219                              ;			
  3220                              ;			LDA		OUT_L
  3221                              ;			STA		R_DispHum
  3222                              ;					
  3223                              ;			RTS
  3224                              ;;------------------------------------------
  3225                              ;; 函数：F_CalculTempC
  3226                              ;; 功能：原始数据转摄氏度 → 正负判断 → 阈值判断 → 打包到R_DispTemper
  3227                              ;; 依赖：CAL_IC_TEMP（温度换算子程序，需外部提供）
  3228                              ;;------------------------------------------
  3229                              ;     
  3230                              ;F_CalculTempC:
  3231                              ;        ; 4.1 准备参数：R_SaveData[0/1] → CNT4/CNT5
  3232                              ;        LDA  R_SaveData+0
  3233                              ;        STA  CNT4
  3234                              ;        LDA  R_SaveData+1
  3235                              ;        STA  CNT5
  3236                              ;        JSR  CAL_IC_TEMP  ; 调用传感器温度换算，结果→TEMP_INTEGAH/L
  3237                              ;				   
  3238                              ;        	
  3239                              ;        ; 4.2 温度正负判断（符号位在TEMP_INTEGAH最高位）
  3240                              ;        LDA  TEMP_INTEGAH
  3241                              ;        AND  #80H         ; 提取符号位（bit7=1→负数）
  3242                              ;        BEQ  ?Positive    ; 符号位=0 → 正数分支
  3243                              ;        
  3244                              ;?Negtive:
  3245                              ;        ; 负温度处理：置位D_Neg，清除符号位取绝对值
  3246                              ;        %bits R_SpecFlag, D_Neg
  3247                              ;        LDA  TEMP_INTEGAH
  3248                              ;        AND  #7FH         ; 清除符号位，保留数值部分 	
  3249                              ;        STA  TEMP_INTEGAH
  3250                              ;        ; 跳转到阈值判断
  3251                              ;        JMP  ?CheckThreshold
  3252                              ;
  3253                              ;?Positive:
  3254                              ;        ; 正温度处理：清除D_Neg标志
  3255                              ;   ;     %bitr R_SpecFlag, D_Neg
  3256                              ;        ; 直接进入阈值判断
  3257                              ;
  3258                              ;?CheckThreshold:
  3259                              ;		LDX  #00H         ; F_CAL_HEX_BCD2输入：X=高位（0），A=温度绝对值
  3260                              ;		LDA  TEMP_INTEGAL
  3261                              ;		JSR  F_CAL_HEX_BCD2  ; 输出：OUT_M=BCD十位，OUT_L=BCD个位	
  3262                              ;        ; 4.3 温度阈值判断（TEMP_INTEGAH为温度绝对值）
  3263                              ;    
  3264                              ;    ; 步骤5：基于BCD码判断阈值（核心修正！）
  3265                              ;    ; 5.1 判断是否>70℃（BCD：十位>7 或 十位=7且个位>0）
  3266                              ;    LDA  OUT_M
  3267                              ;    CMP  #C_TEMP_HH  ; 比较十位（7）
  3268                              ;    BCS  ?SetTempHH        ; 十位>7 → 肯定>70℃
  3269                              ;    JMP  ?CheckTempLL
  3270                              ;?SetTempHH:
  3271                              ;    %bits R_SpecFlag, D_TempHH  ; 置位>70℃标志
  3272                              ;    JMP  ?PackTemp
  3273                              ;    
  3274                              ;    ; 5.2 判断是否<-9℃（仅负数+BCD绝对值>9）
  3275                              ;?CheckTempLL:
  3276                              ;    %btsf R_SpecFlag, D_Neg, ?PackTemp  ; 正数跳过低温判断
  3277                              ;    ; 负数：判断BCD绝对值是否>9（个位>9 或 十位≥1）
  3278                              ;    LDA  OUT_M
  3279                              ;    BNE  ?SetTempLL        ; 十位≥1 → 绝对值≥10 >9
  3280                              ;    LDA  OUT_L
  3281                              ;    CMP  #C_TEMP_LL  ; 个位>9 → 绝对值>9
  3282                              ;    BCS  ?SetTempLL
  3283                              ;    JMP  ?PackTemp
  3284                              ;?SetTempLL:
  3285                              ;    %bits R_SpecFlag, D_TempLL  ; 置位<-9℃标志
  3286                              ;    
  3287                              ;    ; 步骤6：温度数据打包（1字节）
  3288                              ;?PackTemp:
  3289                              ;    LDA  OUT_M
  3290                              ;    AND  #0FH          ; 确保十位是0~9（BCD范围）
  3291                              ;    ASL  A             ; 左移1位
  3292                              ;    ASL  A             ; 左移2位
  3293                              ;    ASL  A             ; 左移3位 → 移到bit3~0 → 再调整到bit6~4
  3294                              ;    ASL  A             ; 左移4位 → 十位进入bit4~7（后续只保留bit6~4）
  3295                              ;    STA  R_DispTemper
  3296                              ;
  3297                              ;    ; 6.4 打包BCD个位（OUT_L → bit3~0）
  3298                              ;    LDA  OUT_L
  3299                              ;    AND  #F0H          ; 确保个位是0~9
  3300                              ;    ROR	 A	
  3301                              ;    ROR	 A	 
  3302                              ;    ROR	 A	
  3303                              ;    ROR	 A	
  3304                              ;    
  3305                              ;    ORA  R_DispTemper  ; 合并个位到bit3~0
  3306                              ;    STA  R_DispTemper  ; 最终打包完成
  3307                              ;    
  3308                              ;    RTS
  3309                              ;==========================================================	
  3310                              ;F_Delay10ms:
  3311                              ;		JSR		F_SendDataDelay
  3312                              ;		JSR		F_SendDataDelay
  3313                              ;		JSR		F_SendDataDelay
  3314                              ;		RTS
  3315                              ;		
  3316                              ;
  3317                              ;		
  3318                              ;.PUBLIC		F_SendDataDelay
  3319                              ;F_SendDataDelay:	
  3320                              ;			LDX		#1FH	
  3321                              ;	?Loop1:		
  3322                              ;			LDA		#3FH
  3323                              ;			STA		R_DelayTemp			
  3324                              ;	?Loop2:
  3325                              ;			DEC		R_DelayTemp
  3326                              ;			LDA		R_DelayTemp
  3327                              ;			BNE		?Loop2			
  3328                              ;			DEX
  3329                              ;			BNE		?Loop1			
  3330                              ;			RTS	        
