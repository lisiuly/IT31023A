  1242                      <       LCDConvert		.MACRO  com,seg
  1243                      <       			DB	com*10H+(seg/8)+00H,1<<(seg.AND.07H)	;GPL813P01;
  1244                      <       			
  1245                      <       			.ENDM
  1246                      <       			
  1247                      <       %LCD7S        .MACRO   i1c,i1s,i2c,i2s,i3c,i3s,i4c,i4s,i5c,i5s,i6c,i6s,i7c,i7s
  1248                      <                      LCDConvert    i1c,i1s
  1249                      <                      LCDConvert    i2c,i2s
  1250                      <                      LCDConvert    i3c,i3s
  1251                      <                      LCDConvert    i4c,i4s
  1252                      <                      LCDConvert    i5c,i5s
  1253                      <                      LCDConvert    i6c,i6s
  1254                      <                      LCDConvert    i7c,i7s
  1255                      <                      .ENDM
  1256                      <                      
  1257                      <       %LCD8S:        .MACRO   i1c,i1s,i2c,i2s,i3c,i3s,i4c,i4s,i5c,i5s,i6c,i6s,i7c,i7s,i8c,i8s
  1258                      <                      LCDConvert    i1c,i1s
  1259                      <                      LCDConvert    i2c,i2s
  1260                      <                      LCDConvert    i3c,i3s
  1261                      <                      LCDConvert    i4c,i4s
  1262                      <                      LCDConvert    i5c,i5s
  1263                      <                      LCDConvert    i6c,i6s
  1264                      <                      LCDConvert    i7c,i7s
  1265                      <       		       LCDConvert    i8c,i8s
  1266                      <                      .ENDM  
  1267                      <       ;;================================================================
  1268                      <       ;Kind   :Count Loop
  1269                      <       ;================================================================		                    
  1270                      <       %DJNZ:               .MACRO       Var,Lable    ;  !=0
  1271                      <                             DEC          Var
  1272                      <                             BNE          Lable
  1273                      <                            .ENDM
  1274                      <       		
  1275                      <       ;----------------------------------------------------------
  1276                      <       ;/***********************************************/
  1277                      <       ;         i.L=1 
  1278                      <       %bits:   .MACRO   i,L             ;BYTE i;  
  1279                      <                 lda     i               ;ex.  
  1280                      <                 ora     #L              ;  %bits 10H,_BIT0
  1281                      <       		                   ;  10H.0=1
  1282                      <                 sta     i               ;
  1283                      <                .ENDM    
  1284                      <       
  1285                      <       ;/***********************************************/
  1286                      <       ;         i.L=0
  1287                      <       %bitr:   .MACRO   i,L             ;BYTE i;  
  1288                      <                 lda     i               ;ex.  
  1289                      <                 and     #.NOT.L         ;  %bitr 10H,_BIT0;  10H.0=0
  1290                      <                 sta     i
  1291                      <                .ENDM    
  1292                      <       
  1293                      <       ;/***********************************************/
  1294                      <       ;         if(i.L==1) goto N
  1295                      <       %btst:   .MACRO   i,L,N           ;BYTE i;  
  1296                      <                 lda     i               ;ex.   
  1297                      <                 and     #L              ;  %btst 10H,_BIT0,N
  1298                      <                 bne     N               ;  if(10H.0=1) goto N 
  1299                      <                .ENDM    
  1300                      <                                         
  1301                      <       ;/***********************************************/
  1302                      <       ;         if(i.L==0) goto N
  1303                      <       %btsf:   .MACRO   i,L,N           ;BYTE i;    
  1304                      <                 lda     i               ;ex.   
  1305                      <                 and     #L              ;  %btsf 10H,_BIT0,N
  1306                      <                 beq     N               ;  if(10H.0=0) goto N 
  1307                      <                .ENDM    
  1308                      <        
