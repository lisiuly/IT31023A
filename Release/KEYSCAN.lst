  1638                              ; Return		: none
  1639                              ; Destroy		: none 
  1640                              ; Stack depth	: none
  1641                              ; =============================================
  1642                              %WaitDebounceOver	.MACRO	NotOver
  1643                              			LDA	 R_DebounceCnt
  1644                              			BNE	 NotOver
  1645                              ?L_Need#:		
  1646                              	.ENDM
