  1648                              ; =============================================
  1649 0000F462                     F_KeyScan:
  1650 0000F462                     _F_KeyScan:
  1651 0000F462 EA                  		NOP	
  1652                              		%btst R_KeyFlag, D_LCDOFF, ?PowerOffScan
  1653 0000F463 A5 71             1           lda     R_KeyFlag               ;ex.   
  1654 0000F465 29 02             1           and     #D_LCDOFF              ;  %btst 10H,_BIT0,N
  1655 0000F467 D0 08             1           bne     ?PowerOffScan               ;  if(10H.0=1) goto N 
  1656 0000F469 AD 92 30            		LDA	P_IO_PortB_Data
  1657 0000F46C 29 7E               		AND	#(D_AlarmKey+D_TimerKey+D_UpKey+D_DownKey+D_PowerKey+D_TimeKey)
  1658 0000F46E 4C 76 F4            		JMP	?CheckKey
  1659 0000F471                     ?PowerOffScan:
  1660 0000F471 AD 92 30            		LDA	P_IO_PortB_Data
  1661 0000F474 29 40               		AND	#D_PowerKey
  1662 0000F476                     ?CheckKey:
  1663 0000F476 F0 12               		BEQ	?ReleaseAllKey
  1664                              		
  1665 0000F478 85 6F               		STA	R_KeyTemp
  1666 0000F47A A5 6F               		LDA	R_KeyTemp
  1667 0000F47C C5 6E               		CMP	R_KeyValue
  1668 0000F47E F0 6E               		BEQ	?CheckKeyDebounce
  1669                              		
  1670 0000F480 A5 6F               		LDA	R_KeyTemp
  1671 0000F482 85 6E               		STA	R_KeyValue
  1672 0000F484 A9 04               		LDA	#C_KeyDebounce
  1673 0000F486 85 68               		STA	R_DebounceCnt
  1674 0000F488 58                  		CLI
  1675 0000F489 60                  		RTS			
  1676                              ;按键释放-------------------------			
  1677 0000F48A                     ?ReleaseAllKey:
  1678 0000F48A EA                  		NOP
  1679                              		%btst R_KeyFlag, D_LCDOFF, ?Next1
  1680 0000F48B A5 71             1           lda     R_KeyFlag               ;ex.   
  1681 0000F48D 29 02             1           and     #D_LCDOFF              ;  %btst 10H,_BIT0,N
  1682 0000F48F D0 4E             1           bne     ?Next1               ;  if(10H.0=1) goto N 
  1683                              		%btst	R_KeyFlag,D_KeyRelDis,?Next1
  1684 0000F491 A5 71             1           lda     R_KeyFlag               ;ex.   
  1685 0000F493 29 08             1           and     #D_KeyRelDis              ;  %btst 10H,_BIT0,N
  1686 0000F495 D0 48             1           bne     ?Next1               ;  if(10H.0=1) goto N 
  1687 0000F497 A5 70               		LDA		R_OldKeyValue
  1688 0000F499 F0 44               		BEQ		?Next1
  1689                              
  1690 0000F49B                     	?Skip_AlarmZzFunOff:		
  1691                              ;		%bits	R_KeyFlag,D_KeyTone	;按键音
  1692 0000F49B A5 88               	LDA		R_VoiceFlag
  1693 0000F49D 29 01               	AND		#D_OpenReady
  1694 0000F49F F0 0C               	BEQ		?No_Beep
  1695                              		%btst   R_KeyFlag,D_KeyTone,?No_Beep
  1696 0000F4A1 A5 71             1           lda     R_KeyFlag               ;ex.   
  1697 0000F4A3 29 04             1           and     #D_KeyTone              ;  %btst 10H,_BIT0,N
  1698 0000F4A5 D0 06             1           bne     ?No_Beep               ;  if(10H.0=1) goto N 
  1699                              		%bits	R_VoiceReq,D_VOICE_BEEP	;按键音
  1700 0000F4A7 A5 8A             1           lda     R_VoiceReq               ;ex.  
  1701 0000F4A9 09 10             1           ora     #D_VOICE_BEEP              ;  %bits 10H,_BIT0
  1702                            1 		                   ;  10H.0=1
  1703 0000F4AB 85 8A             1           sta     R_VoiceReq               ;
  1704 0000F4AD                     	?No_Beep:   	
  1705 0000F4AD A5 70               		LDA		R_OldKeyValue	
  1706 0000F4AF C9 20               		CMP		#D_TimeKey			
  1707 0000F4B1 D0 03               		BNE		$+5
  1708 0000F4B3 4C A3 F6            		JMP		Enable_TimeKey		;时间设置键
  1709 0000F4B6 C9 02               		CMP		#D_AlarmKey			
  1710 0000F4B8 D0 03               		BNE		$+5
  1711 0000F4BA 4C E5 F6            		JMP		Enable_AlarmKey		;闹钟设置键
  1712 0000F4BD C9 40               		CMP		#D_PowerKey
  1713 0000F4BF D0 03               		BNE		$+5		
  1714 0000F4C1 4C 31 F5            		JMP		Enable_BackLEDKey		;背光调节键	
  1715 0000F4C4 C9 08               		CMP		#D_UpKey			;;+键
  1716 0000F4C6 D0 03               	    BNE		$+5
  1717 0000F4C8 4C 52 F8            		JMP		Enable_UpKey		
  1718 0000F4CB C9 10               		CMP		#D_DownKey			;;-键
  1719 0000F4CD D0 03               		BNE		$+5
  1720 0000F4CF 4C C6 F9            		JMP		Enable_DownKey
  1721 0000F4D2 C9 04               		CMP		#D_TimerKey			
  1722 0000F4D4 D0 03               		BNE		$+5
  1723 0000F4D6 4C 6F F7            		JMP		Enable_TimerKey		;定时键:计时中按下可暂停/继续计时
  1724                              		%bitr	R_VoiceReq,D_VOICE_BEEP	;按键音
  1725 0000F4D9 A5 8A             1           lda     R_VoiceReq               ;ex.  
  1726 0000F4DB 29 EF             1           and     #.NOT.D_VOICE_BEEP         ;  %bitr 10H,_BIT0;  10H.0=0
  1727 0000F4DD 85 8A             1           sta     R_VoiceReq
  1728 0000F4DF                     	?Next1:			
  1729 0000F4DF A9 00               		LDA	#00
  1730 0000F4E1 85 70               		STA	R_OldKeyValue
  1731 0000F4E3 85 6E               		STA	R_KeyValue
  1732 0000F4E5 85 6F               		STA	R_KeyTemp
  1733                              		%bitr	R_KeyFlag,(D_EnableFastAdd+D_KeyRelDis)
  1734 0000F4E7 A5 71             1           lda     R_KeyFlag               ;ex.  
  1735 0000F4E9 29 F6             1           and     #.NOT.(D_EnableFastAdd+D_KeyRelDis)         ;  %bitr 10H,_BIT0;  10H.0=0
  1736 0000F4EB 85 71             1           sta     R_KeyFlag
  1737 0000F4ED                     	?Next2:		
  1738 0000F4ED 60                  		RTS
  1739                              		
  1740 0000F4EE                     ?CheckKeyDebounce:
  1741 0000F4EE A5 68               		LDA	R_DebounceCnt
  1742 0000F4F0 F0 01               		BEQ	?Key_Process		
  1743 0000F4F2 60                  		RTS			
  1744 0000F4F3                     	?Key_Process:		;按键是否新按下的按键
  1745 0000F4F3 A5 6E               		LDA	R_KeyValue
  1746 0000F4F5 C5 70               		CMP	R_OldKeyValue
  1747 0000F4F7 D0 03               		BNE	$+5
  1748 0000F4F9 4C 61 F5            		JMP	Hold_Key
  1749                              
  1750 0000F4FC                     Enable_NewKey:
  1751                              		;新按下的按键处理
  1752                              ;		JSR		F_OpenBacklight
  1753                              			%bitr	R_KeyFlag,(D_KeyRelDis+D_EnableFastAdd)
  1754 0000F4FC A5 71             1           lda     R_KeyFlag               ;ex.  
  1755 0000F4FE 29 F6             1           and     #.NOT.(D_KeyRelDis+D_EnableFastAdd)         ;  %bitr 10H,_BIT0;  10H.0=0
  1756 0000F500 85 71             1           sta     R_KeyFlag
  1757                              ;			%bitr	R_KeyFlag,D_EnableFastAdd
  1758                              ;			%bits	R_KeyFlag,D_KeyTone	;按键音
  1759 0000F502                     	?SkipKeyTone:
  1760 0000F502 A9 FF               			LDA		#C_LongKey2Sec
  1761 0000F504 85 72               			STA		R_LongKeyTime	;长按3秒开始计时			
  1762 0000F506 A5 6E               			LDA		R_KeyValue
  1763 0000F508 85 70               			STA		R_OldKeyValue
  1764                              			; 如果按下的不是闹钟键，则刷新闹钟查看语音标志（允许下次短按播放）
  1765 0000F50A A5 6E               			LDA		R_KeyValue
  1766 0000F50C C9 02               			CMP		#D_AlarmKey
  1767 0000F50E F0 04               			BEQ		?Skip_ClearAlarmView
  1768 0000F510 A9 00               			LDA		#00
  1769 0000F512 85 8B               			STA		R_AlarmViewFlag
  1770 0000F514                     		?Skip_ClearAlarmView:
  1771                              				; 若语音模块已打开，刷新 UART 打开计时，用于保持语音唤醒状态
  1772 0000F514 A5 88               				LDA		R_VoiceFlag
  1773 0000F516 29 01               				AND		#D_OpenReady
  1774 0000F518 F0 04               				BEQ		?NoRefreshUartOpen
  1775 0000F51A A9 3C               				LDA		#D_UI_Time
  1776 0000F51C 85 8C               				STA		R_Uart_OpenTime
  1777 0000F51E                     	?NoRefreshUartOpen:
  1778                              ;	            %btst   R_KeyFlag,D_KeyTone,?NoBeep
  1779                              ;	            LDA     R_VoiceReq
  1780                              ;	            ORA     #D_VOICE_BEEP
  1781                              ;	            STA     R_VoiceReq
  1782 0000F51E                     	?NoBeep:
  1783                              	 %btsf   R_OtherFlag,D_Alarming,?L_Exit ; 仅在响铃时响应贪睡
  1784 0000F51E A5 73             1           lda     R_OtherFlag               ;ex.   
  1785 0000F520 29 40             1           and     #D_Alarming              ;  %btsf 10H,_BIT0,N
  1786 0000F522 F0 0C             1           beq     ?L_Exit               ;  if(10H.0=0) goto N 
  1787                              ;			%bits	R_OtherFlag,D_ToneDIS	
  1788                              ;			LDA		R_OldKeyValue		
  1789                              ;			CMP		#D_SleepKey			
  1790                              ;			BNE		?Next1
  1791                              ;			JSR		F_UpdateKey			
  1792                              ;			%bits	R_OtherFlag,D_EnableSnooze
  1793                              ;			LDA		#C_SnoozeTime5min
  1794                              ;			STA		R_SleepTime
  1795                              ;			rts
  1796                              	 		%bits	R_KeyFlag,D_KeyRelDis
  1797 0000F524 A5 71             1           lda     R_KeyFlag               ;ex.  
  1798 0000F526 09 08             1           ora     #D_KeyRelDis              ;  %bits 10H,_BIT0
  1799                            1 		                   ;  10H.0=1
  1800 0000F528 85 71             1           sta     R_KeyFlag               ;
  1801                              	 		%bits	R_OtherFlag,D_ToneDIS	
  1802 0000F52A A5 73             1           lda     R_OtherFlag               ;ex.  
  1803 0000F52C 09 08             1           ora     #D_ToneDIS              ;  %bits 10H,_BIT0
  1804                            1 		                   ;  10H.0=1
  1805 0000F52E 85 73             1           sta     R_OtherFlag               ;
  1806                              ;		?Next1:	
  1807                              ;			%bitr	R_OtherFlag,D_EnableSnooze
  1808                              		; 	LDA		R_TimeFlashSet	;timer退出设置
  1809                              		; 	ORA		R_AlmTimeFlashSet
  1810                              		; 	ORA		R_VolumeFlashSet
  1811                              		; 	BEQ		?L_Exit			
  1812                              		; 	LDA		R_OldKeyValue		
  1813                              		; 	CMP		#D_TimerKey			
  1814                              		; 	BNE		?L_Exit		
  1815                              		; 	JSR		F_UpdateKey	
  1816                              		; 	LDA		#00
  1817                              		; 	STA		R_TimeFlashSet
  1818                              		; 	STA		R_AlmTimeFlashSet
  1819                              		; 	STA		R_VolumeFlashSet	
  1820                              		; 	LDA		R_VolumeFlashSet	;退出曲设置
  1821                              		; 	BEQ		?L_Exit
  1822                              		; 	%bits	R_OtherFlag,D_ToneDIS
  1823                              		; 	LDA		#0
  1824                              		; 	STA		R_VolumeFlashSet			
  1825 0000F530                     		 ?L_Exit:
  1826 0000F530 60                  			RTS
  1827 0000F531                     Enable_BackLEDKey:
  1828                              		; 3档背光循环：1->2->3->1，过滤无效值         
  1829 0000F531 20 41 F8            		JSR		F_UpdateKey	
  1830 0000F534 AD C0 02            		LDA		_R_BacklightLevel
  1831 0000F537 C9 01               		CMP		#1
  1832 0000F539 F0 10               		BEQ		?BackLED_Set2
  1833 0000F53B C9 02               		CMP		#2
  1834 0000F53D F0 14               		BEQ		?BackLED_Set3
