  2671                              ; ==============================================
  2672                              ; 函数名：L_Calc_week_up_head
  2673                              ; 功能：调节月份后，检查并修正日期
  2674                              ; 说明：切换月份后，若当前日期 > 该月最大天数，重置为该月最大天数
  2675                              ; ==============================================		
  2676 0000F916                     L_Calc_week_up_head:
  2677 0000F916 A6 05               		LDX     R_Month             ; 载入当前调节后的月份到X
  2678 0000F918 20 74 FA            		JSR     F_GetMonthDays      ; A = 该月最大天数（已处理2月闰年）
  2679                              		
  2680 0000F91B C5 07               		CMP     R_Day               ; 比较：当月最大天数(A) vs 当前日期(R_Day)
  2681 0000F91D 90 03               		BCC     ?ResetDay           ; 若A < R_Day（日期超限），跳转重置
  2682 0000F91F 4C E9 F8            		JMP     L_Calc_week_up      ; 日期合法，执行后续逻辑
  2683                              		
  2684 0000F922                     	?ResetDay:
  2685                              		; 直接使用之前获取的A值（当月最大天数）重置日期，无冗余操作
  2686 0000F922 85 07               		STA     R_Day               ; 核心：将日期重置为当月最大天数
  2687 0000F924 4C E9 F8            		JMP     L_Calc_week_up      ; 重置后执行后续逻辑  
