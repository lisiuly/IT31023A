   801                      <       ;**********************************************************************
   802                      <       ;ROM Checksum
   803                      <       ;**********************************************************************
   804                      <       .IF (GPL815P04Ax)
   805                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5, 0x8000 ~ 0xBFFF
   806                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   807                      <       ;				   
   808                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   809                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   810                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0xBFFF:User ROM Code
   811                      <       	D_Bank0HUserRomEndAddr:			.EQU	0xBFFF	
   812                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   813                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   814                      <       .ENDIF
   815                      <       
   816                      <       .IF (GPL815P04Ax_16KB)
   817                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5
   818                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   819                      <       ;				   
   820                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   821                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   822                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   823                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   824                      <       .ENDIF	
   825                      <       
   826                      <       .IF (GPL815P04Bx)
   827                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5, 0x8000 ~ 0xBFFF (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   828                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   829                      <       ;				   
   830                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   831                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   832                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0xBFFF:User ROM Code
   833                      <       	D_Bank0HUserRomEndAddr:			.EQU	0xBFFF	
   834                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   835                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   836                      <       .ENDIF	
   837                      <       
   838                      <       .IF (GPL815P04Bx_15KB)
   839                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5 (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   840                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   841                      <       ;				   
   842                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   843                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   844                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   845                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   846                      <       .ENDIF
   847                      <       
   848                      <       .IF (GPL815P03Ax)
   849                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5, 0x8000 ~ 0x9FFF
   850                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   851                      <       ;				   
   852                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   853                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   854                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0x9FFF:User ROM Code
   855                      <       	D_Bank0HUserRomEndAddr:			.EQU	0x9FFF	
   856                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   857                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD
   858                      <       .ENDIF
   859                      <       
   860                      <       .IF (GPL815P03Bx)
   861                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5, 0x8000 ~ 0x9FFF (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   862                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   863                      <       ;				   
   864                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   865                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   866                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0x9FFF:User ROM Code
   867                      <       	D_Bank0HUserRomEndAddr:			.EQU	0x9FFF	
   868                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   869                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD
   870                      <       .ENDIF	
   871                      <       
   872                      <       .IF (GPL815P02Ax)
   873                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5
   874                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   875                      <       ;				   
   876                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   877                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   878                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   879                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   880                      <       .ENDIF	
   881                      <       ; ========================================================================================
   882                      <       ; Macro Name	: M_UserRomChecksum
   883                      <       ; Parameters	: None
   884                      <       ; Return Value	: R_ChecksumResult: bit[7:0]
   885                      <       ;				: R_ChecksumResult + 1: bit[15:8]
   886                      <       ;				: R_ChecksumResult + 2: bit[23:16]
   887                      <       ;				: R_ChecksumResult + 3: bit[31:24]
   888                      <       ; Description	: Calculate user ROM area code checksum
   889                      <       ; Destroy		: A, X
   890                      <       ; Example		: %M_UserRomChecksum	R_ChecksumAddrPtr, R_ChecksumResult
   891                      <       ; ========================================================================================	
   892                      <       %M_UserRomChecksum:	.MACRO	R_ChecksumAddrPtr, R_ChecksumResult
   893                      <       	LDA		#0
   894                      <       	STA		R_ChecksumResult					;Result Byte0
   895                      <       	STA		R_ChecksumResult + 1				;Result Byte1
   896                      <       	STA		R_ChecksumResult + 2				;Result Byte2
   897                      <       	STA		R_ChecksumResult + 3				;Result Byte3
   898                      <       ;=================== Bank 0 ==================================================	
   899                      <       	LDA		#.HIGH.D_Bank0UserRomStartAddr
   900                      <       	STA		R_ChecksumAddrPtr + 1				;Start High Byte
   901                      <       	LDA		#.LOW.D_Bank0UserRomStartAddr
   902                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   903                      <       		
   904                      <       	LDY		#0	
   905                      <       
   906                      <       L_ChecksumLoop1?
   907                      <       	STA	   P_WDT_Clear	
   908                      <       	CLC
   909                      <       	LDA		(R_ChecksumAddrPtr),Y
   910                      <       	ADC		R_ChecksumResult					;Result Low Byte
   911                      <       	STA		R_ChecksumResult					;Result Low Byte
   912                      <       	BCC		L_CheckAddress1?
   913                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   914                      <       	BNE		L_CheckAddress1?
   915                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   916                      <       	BNE		L_CheckAddress1?
   917                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   918                      <       		
   919                      <       L_CheckAddress1?:
   920                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   921                      <       	CMP		#.HIGH.D_Bank0UserRomEndAddr		;End High Byte
   922                      <       	BNE		L_IncreaseAdd1?
   923                      <       	
   924                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   925                      <       	CMP		#.LOW.D_Bank0UserRomEndAddr			;End Low Byte
   926                      <       	BEQ		L_ExitRomSum1?
   927                      <       	
   928                      <       L_IncreaseAdd1?:
   929                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   930                      <       	BNE		L_ChecksumLoop1?
   931                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   932                      <       	JMP		L_ChecksumLoop1?	
   933                      <       		
   934                      <       L_ExitRomSum1?:		
   935                      <       .IF (GPL815P04Ax+GPL815P04Bx+GPL815P03Ax+GPL815P03Bx)	
   936                      <       ;===================================Bank0H==============================================
   937                      <       	LDA		#.HIGH.D_Bank0HUserRomStartAddr
   938                      <       	STA		R_ChecksumAddrPtr + 1				;Start High Byte
   939                      <       	LDA		#.LOW.D_Bank0HUserRomStartAddr
   940                      <       	STA		R_ChecksumAddrPtr
   941                      <       	
   942                      <       L_ChecksumLoop1H?
   943                      <       	STA	   P_WDT_Clear	
   944                      <       	CLC
   945                      <       	LDA		(R_ChecksumAddrPtr),Y
   946                      <       	ADC		R_ChecksumResult					;Result Low Byte
   947                      <       	STA		R_ChecksumResult					;Result Low Byte
   948                      <       	BCC		L_CheckAddress1H?
   949                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   950                      <       	BNE		L_CheckAddress1H?
   951                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   952                      <       	BNE		L_CheckAddress1H?
   953                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   954                      <       		
   955                      <       L_CheckAddress1H?:
   956                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   957                      <       	CMP		#.HIGH.D_Bank0HUserRomEndAddr		;End High Byte
   958                      <       	BNE		L_IncreaseAdd1H?
   959                      <       	
   960                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   961                      <       	CMP		#.LOW.D_Bank0HUserRomEndAddr			;End Low Byte
   962                      <       	BEQ		L_ExitRomSum1H?
   963                      <       	
   964                      <       L_IncreaseAdd1H?:
   965                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   966                      <       	BNE		L_ChecksumLoop1H?
   967                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   968                      <       	JMP		L_ChecksumLoop1H?	
   969                      <       		
   970                      <       L_ExitRomSum1H?:	
   971                      <       .ENDIF	
   972                      <       ;===================NMI & Reset Vector==================================================		
   973                      <       	LDA		#.HIGH.D_NMIandResetVectorStartAddr
   974                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   975                      <       	LDA		#.LOW.D_NMIandResetVectorStartAddr
   976                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   977                      <       		
   978                      <       L_ChecksumLoop2?
   979                      <       	STA	   P_WDT_Clear		
   980                      <       	CLC
   981                      <       	LDA		(R_ChecksumAddrPtr),Y
   982                      <       	ADC		R_ChecksumResult					;Result Low Byte
   983                      <       	STA		R_ChecksumResult					;Result Low Byte
   984                      <       	BCC		L_CheckAddress2?
   985                      <       	INC		R_ChecksumResult + 1				;Result Byte2
   986                      <       	BNE		L_CheckAddress2?
   987                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   988                      <       	BNE		L_CheckAddress2?
   989                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   990                      <       		
   991                      <       L_CheckAddress2?:
   992                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   993                      <       	CMP		#.HIGH.D_NMIandResetVectorEndAddr	;End High Byte
   994                      <       	BNE		L_IncreaseAdd2?
   995                      <       	
   996                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   997                      <       	CMP		#.LOW.D_NMIandResetVectorEndAddr	;End Low Byte
   998                      <       	BEQ		L_ExitRomSum2?
   999                      <       	
  1000                      <       L_IncreaseAdd2?:
  1001                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
  1002                      <       	BNE		L_ChecksumLoop2?
  1003                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
  1004                      <       	JMP		L_ChecksumLoop2?	
  1005                      <       		
  1006                      <       L_ExitRomSum2?:	
  1007                      <       	.ENDM
  1008                      <       
  1009                      <       	.ENDIF
  1010                      <       .endif
  1011                      <       	.ENDIF	
