  2991                              ; 函数名：F_GetMonthDays
  2992                              ; 功能：获取指定月份的天数（自动处理闰年二月）
  2993                              ; 输入：X = 月份 (1-12)
  2994                              ; 输出：A = 该月的天数
  2995                              ; 破坏的寄存器：A
  2996                              ; ==============================================
  2997 0000FA74                     F_GetMonthDays:
  2998 0000FA74 E0 02                   CPX     #2          ; 检查是否是2月
  2999 0000FA76 D0 0C                   BNE     ?NotFebruary ; 不是2月，跳转到查表处理
  3000                                  ; 处理2月 - 检查闰年标志
  3001 0000FA78 A5 1D                   LDA     R_Hejira_LeapYear_CalendarFlag
  3002 0000FA7A 29 80                   AND     #D_LeapYear
  3003 0000FA7C D0 03                   BNE     ?LeapYear  
  3004                                  ; 平年2月
  3005 0000FA7E A9 1C                   LDA     #28
  3006 0000FA80 60                      RTS 
  3007 0000FA81                     ?LeapYear:
  3008                                  ; 闰年2月
  3009 0000FA81 A9 1D                   LDA     #29
  3010 0000FA83 60                      RTS
  3011 0000FA84                     ?NotFebruary:
  3012                                  ; 其他月份 - 直接查表
  3013 0000FA84 BD 2D FB                LDA     T_key_Month_Table, x
  3014 0000FA87 60                      RTS
