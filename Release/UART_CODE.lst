  1197                              ; Function name : F_UART_Baudrate
  1198                              ; Purpose       : change UART baudrate 
  1199                              ; Parameter     : Acc=Level
  1200                              ;   Acc = 0 : Baudrate = 460800
  1201                              ;   Acc = 1 : Baudrate = 230400
  1202                              ;   Acc = 2 : Baudrate = 115200
  1203                              ;   Acc = 3 : Baudrate = 76800
  1204                              ;   Acc = 4 : Baudrate = 57600
  1205                              ;   Acc = 5 : Baudrate = 38400
  1206                              ;   Acc = 6 : Baudrate = 28800
  1207                              ;   Acc = 7 : Baudrate = 19200
  1208                              ;   Acc = 8 : Baudrate = 14400
  1209                              ;   Acc = 9 : Baudrate = 9600
  1210                              ;   Acc = A : Baudrate = 4800
  1211                              ;   Acc = B : Baudrate = 2400
  1212                              ;   Acc = C : Baudrate = 1200
  1213                              ; Return        : A=0: Pass
  1214                              ;                 A=1: Level error
  1215                              ; Destroy       : A, Y 
  1216                              ; ======================================================================================
  1217 0000FBA8                     F_UART_Baudrate:
  1218 0000FBA8                     _F_UART_Baudrate:
  1219 0000FBA8 C9 0D               	CMP		#0Dh
  1220 0000FBAA 90 03               	BCC		L_BaudrateSel?
  1221 0000FBAC A9 01               	LDA		#1
  1222 0000FBAE 60                  	RTS
  1223                              	
  1224 0000FBAF                     L_BaudrateSel?:
  1225 0000FBAF 18                  	CLC
  1226 0000FBB0 2A                  	ROL		A
  1227 0000FBB1 A8                  	TAY
  1228 0000FBB2 B9 C7 FB            	LDA		T_BaudrateSel,Y
  1229 0000FBB5 8D 55 31            	STA		P_UART_BaudRate_LB
  1230 0000FBB8 B9 C8 FB            	LDA		T_BaudrateSel+1,Y
  1231 0000FBBB 8D 54 31            	STA		P_UART_BaudRate_HB
  1232 0000FBBE B9 E1 FB            	LDA		T_BaudrateSel_FMD,Y
  1233 0000FBC1 8D 5A 31            	STA		P_UART_FMD
  1234 0000FBC4 A9 00               	LDA     #0
  1235 0000FBC6 60                      RTS
  1236                              
  1237 0000FBC7                     T_BaudrateSel:
  1238 0000FBC7 00 00 00 00         	.DW		D_Baudrate_460800, D_Baudrate_230400, D_Baudrate_115200, D_Baudrate_76800
                00 00 00 00
                           
  1239 0000FBCF 01 00 02 00         	.DW		D_Baudrate_57600, D_Baudrate_38400, D_Baudrate_28800, D_Baudrate_19200
                03 00 05 00
                           
  1240 0000FBD7 07 00 0C 00         	.DW		D_Baudrate_14400, D_Baudrate_9600, D_Baudrate_4800, D_Baudrate_2400
                19 00 34 00
                           
  1241 0000FBDF 69 00               	.DW		D_Baudrate_1200
  1242                              	
  1243 0000FBE1                     T_BaudrateSel_FMD:	
  1244 0000FBE1 00 00 02 00         	.DW		D_FMD_460800, D_FMD_230400, D_FMD_115200, D_FMD_76800
                02 00 0B 00
                           
  1245 0000FBE9 04 00 05 00         	.DW		D_FMD_57600, D_FMD_38400, D_FMD_28800, D_FMD_19200
                07 00 0B 00
                           
  1246 0000FBF1 0E 00 05 00         	.DW		D_FMD_14400, D_FMD_9600, D_FMD_4800, D_FMD_2400
                0B 00 05 00
                           
  1247 0000FBF9 0B 00               	.DW		D_FMD_1200	
  1248                              	
  1249 0000FBFB 60                  	RTS	
