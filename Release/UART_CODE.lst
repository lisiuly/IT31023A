   792                      <       ;**********************************************************************
   793                      <       ;ROM Checksum
   794                      <       ;**********************************************************************
   795                      <       .IF (GPL815P04Ax)
   796                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5, 0x8000 ~ 0xBFFF
   797                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   798                      <       ;				   
   799                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   800                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   801                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0xBFFF:User ROM Code
   802                      <       	D_Bank0HUserRomEndAddr:			.EQU	0xBFFF	
   803                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   804                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   805                      <       .ENDIF
   806                      <       
   807                      <       .IF (GPL815P04Ax_16KB)
   808                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5
   809                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   810                      <       ;				   
   811                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   812                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   813                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   814                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   815                      <       .ENDIF	
   816                      <       
   817                      <       .IF (GPL815P04Bx)
   818                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5, 0x8000 ~ 0xBFFF (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   819                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   820                      <       ;				   
   821                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   822                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   823                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0xBFFF:User ROM Code
   824                      <       	D_Bank0HUserRomEndAddr:			.EQU	0xBFFF	
   825                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   826                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   827                      <       .ENDIF	
   828                      <       
   829                      <       .IF (GPL815P04Bx_15KB)
   830                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5 (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   831                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   832                      <       ;				   
   833                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   834                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   835                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   836                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   837                      <       .ENDIF
   838                      <       
   839                      <       .IF (GPL815P03Ax)
   840                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5, 0x8000 ~ 0x9FFF
   841                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   842                      <       ;				   
   843                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   844                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   845                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0x9FFF:User ROM Code
   846                      <       	D_Bank0HUserRomEndAddr:			.EQU	0x9FFF	
   847                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   848                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD
   849                      <       .ENDIF
   850                      <       
   851                      <       .IF (GPL815P03Bx)
   852                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5, 0x8000 ~ 0x9FFF (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   853                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   854                      <       ;				   
   855                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   856                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   857                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0x9FFF:User ROM Code
   858                      <       	D_Bank0HUserRomEndAddr:			.EQU	0x9FFF	
   859                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   860                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD
   861                      <       .ENDIF	
   862                      <       
   863                      <       .IF (GPL815P02Ax)
   864                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5
   865                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   866                      <       ;				   
   867                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   868                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   869                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   870                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   871                      <       .ENDIF	
   872                      <       ; ========================================================================================
   873                      <       ; Macro Name	: M_UserRomChecksum
   874                      <       ; Parameters	: None
   875                      <       ; Return Value	: R_ChecksumResult: bit[7:0]
   876                      <       ;				: R_ChecksumResult + 1: bit[15:8]
   877                      <       ;				: R_ChecksumResult + 2: bit[23:16]
   878                      <       ;				: R_ChecksumResult + 3: bit[31:24]
   879                      <       ; Description	: Calculate user ROM area code checksum
   880                      <       ; Destroy		: A, X
   881                      <       ; Example		: %M_UserRomChecksum	R_ChecksumAddrPtr, R_ChecksumResult
   882                      <       ; ========================================================================================	
   883                      <       %M_UserRomChecksum:	.MACRO	R_ChecksumAddrPtr, R_ChecksumResult
   884                      <       	LDA		#0
   885                      <       	STA		R_ChecksumResult					;Result Byte0
   886                      <       	STA		R_ChecksumResult + 1				;Result Byte1
   887                      <       	STA		R_ChecksumResult + 2				;Result Byte2
   888                      <       	STA		R_ChecksumResult + 3				;Result Byte3
   889                      <       ;=================== Bank 0 ==================================================	
   890                      <       	LDA		#.HIGH.D_Bank0UserRomStartAddr
   891                      <       	STA		R_ChecksumAddrPtr + 1				;Start High Byte
   892                      <       	LDA		#.LOW.D_Bank0UserRomStartAddr
   893                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   894                      <       		
   895                      <       	LDY		#0	
   896                      <       
   897                      <       L_ChecksumLoop1?
   898                      <       	STA	   P_WDT_Clear	
   899                      <       	CLC
   900                      <       	LDA		(R_ChecksumAddrPtr),Y
   901                      <       	ADC		R_ChecksumResult					;Result Low Byte
   902                      <       	STA		R_ChecksumResult					;Result Low Byte
   903                      <       	BCC		L_CheckAddress1?
   904                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   905                      <       	BNE		L_CheckAddress1?
   906                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   907                      <       	BNE		L_CheckAddress1?
   908                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   909                      <       		
   910                      <       L_CheckAddress1?:
   911                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   912                      <       	CMP		#.HIGH.D_Bank0UserRomEndAddr		;End High Byte
   913                      <       	BNE		L_IncreaseAdd1?
   914                      <       	
   915                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   916                      <       	CMP		#.LOW.D_Bank0UserRomEndAddr			;End Low Byte
   917                      <       	BEQ		L_ExitRomSum1?
   918                      <       	
   919                      <       L_IncreaseAdd1?:
   920                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   921                      <       	BNE		L_ChecksumLoop1?
   922                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   923                      <       	JMP		L_ChecksumLoop1?	
   924                      <       		
   925                      <       L_ExitRomSum1?:		
   926                      <       .IF (GPL815P04Ax+GPL815P04Bx+GPL815P03Ax+GPL815P03Bx)	
   927                      <       ;===================================Bank0H==============================================
   928                      <       	LDA		#.HIGH.D_Bank0HUserRomStartAddr
   929                      <       	STA		R_ChecksumAddrPtr + 1				;Start High Byte
   930                      <       	LDA		#.LOW.D_Bank0HUserRomStartAddr
   931                      <       	STA		R_ChecksumAddrPtr
   932                      <       	
   933                      <       L_ChecksumLoop1H?
   934                      <       	STA	   P_WDT_Clear	
   935                      <       	CLC
   936                      <       	LDA		(R_ChecksumAddrPtr),Y
   937                      <       	ADC		R_ChecksumResult					;Result Low Byte
   938                      <       	STA		R_ChecksumResult					;Result Low Byte
   939                      <       	BCC		L_CheckAddress1H?
   940                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   941                      <       	BNE		L_CheckAddress1H?
   942                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   943                      <       	BNE		L_CheckAddress1H?
   944                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   945                      <       		
   946                      <       L_CheckAddress1H?:
   947                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   948                      <       	CMP		#.HIGH.D_Bank0HUserRomEndAddr		;End High Byte
   949                      <       	BNE		L_IncreaseAdd1H?
   950                      <       	
   951                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   952                      <       	CMP		#.LOW.D_Bank0HUserRomEndAddr			;End Low Byte
   953                      <       	BEQ		L_ExitRomSum1H?
   954                      <       	
   955                      <       L_IncreaseAdd1H?:
   956                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   957                      <       	BNE		L_ChecksumLoop1H?
   958                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   959                      <       	JMP		L_ChecksumLoop1H?	
   960                      <       		
   961                      <       L_ExitRomSum1H?:	
   962                      <       .ENDIF	
   963                      <       ;===================NMI & Reset Vector==================================================		
   964                      <       	LDA		#.HIGH.D_NMIandResetVectorStartAddr
   965                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   966                      <       	LDA		#.LOW.D_NMIandResetVectorStartAddr
   967                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   968                      <       		
   969                      <       L_ChecksumLoop2?
   970                      <       	STA	   P_WDT_Clear		
   971                      <       	CLC
   972                      <       	LDA		(R_ChecksumAddrPtr),Y
   973                      <       	ADC		R_ChecksumResult					;Result Low Byte
   974                      <       	STA		R_ChecksumResult					;Result Low Byte
   975                      <       	BCC		L_CheckAddress2?
   976                      <       	INC		R_ChecksumResult + 1				;Result Byte2
   977                      <       	BNE		L_CheckAddress2?
   978                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   979                      <       	BNE		L_CheckAddress2?
   980                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   981                      <       		
   982                      <       L_CheckAddress2?:
   983                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   984                      <       	CMP		#.HIGH.D_NMIandResetVectorEndAddr	;End High Byte
   985                      <       	BNE		L_IncreaseAdd2?
   986                      <       	
   987                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   988                      <       	CMP		#.LOW.D_NMIandResetVectorEndAddr	;End Low Byte
   989                      <       	BEQ		L_ExitRomSum2?
   990                      <       	
   991                      <       L_IncreaseAdd2?:
   992                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   993                      <       	BNE		L_ChecksumLoop2?
   994                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   995                      <       	JMP		L_ChecksumLoop2?	
   996                      <       		
   997                      <       L_ExitRomSum2?:	
   998                      <       	.ENDM
   999                      <       
  1000                      <       	.ENDIF
  1001                      <       .endif
  1002                      <       	.ENDIF	
