  1252                              ; Function name : F_UART_Disable
  1253                              ; Purpose       : Disable UART function
  1254                              ; Parameter     : None
  1255                              ; Return        : None
  1256                              ; Destroy       : A
  1257                              ; ======================================================================================
  1258 0000FBFC                     F_UART_Disable:	
  1259 0000FBFC                     _F_UART_Disable:
  1260 0000FBFC 2C 57 31            	BIT		P_UART_Status2
  1261 0000FBFF 10 FB               	BPL		F_UART_Disable		; wait tx transfer complete
  1262 0000FC01 A9 00               	LDA		#0
  1263 0000FC03 8D 52 31            	STA		P_UART_Ctrl1
  1264 0000FC06 60                  	RTS
