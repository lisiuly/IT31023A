  1266                              ; =======================================================================================
  1267                              ; Function name : F_UART_GetStatus
  1268                              ; Purpose       : Get UART Status (P_UART_Status)
  1269                              ; Parameter     : None 
  1270                              ; Return        : 	Acc = 0 , Status Pass
  1271                              ;					Acc = 1 , FrameError
  1272                              ;					Acc = 2 , ParityError
  1273                              ;					Acc = 3 , BreakError	
  1274                              ;					Acc = 4 , OverrunError
  1275                              ; Destroy       : A
  1276                              ; ======================================================================================	
  1277 0000FC07                     F_UART_GetStatus:	
  1278 0000FC07                     _F_UART_GetStatus:		
  1279 0000FC07 AD 51 31            	LDA		P_UART_RX_Status	
  1280 0000FC0A 29 0F               	AND		#D_FrameErrorFlag+D_ParityErrorFlag+D_BreakErrorFlag+D_OverrunErrorFlag
  1281 0000FC0C 8D D5 02            	STA		R_UARTRX_Status
  1282 0000FC0F F0 1C               	BEQ		L_UART_Status_Pass?
  1283                              	
  1284 0000FC11 AD 51 31            	LDA		P_UART_RX_Status
  1285 0000FC14 29 01               	AND		#D_FrameErrorFlag
  1286 0000FC16 D0 18               	BNE		L_FrameError?
  1287                              	
  1288 0000FC18 AD 51 31            	LDA		P_UART_RX_Status
  1289 0000FC1B 29 02               	AND		#D_ParityErrorFlag
  1290 0000FC1D D0 14               	BNE		L_ParityError?
  1291                              	
  1292 0000FC1F AD 51 31            	LDA		P_UART_RX_Status
  1293 0000FC22 29 04               	AND		#D_BreakErrorFlag
  1294 0000FC24 D0 10               	BNE		L_BreakError?	
  1295                              	
  1296 0000FC26 AD 51 31            	LDA		P_UART_RX_Status
  1297 0000FC29 29 08               	AND		#D_OverrunErrorFlag
  1298 0000FC2B D0 0C               	BNE		L_OverrunError?
  1299                              	
  1300                              	
  1301 0000FC2D                     L_UART_Status_Pass?:			
  1302 0000FC2D A9 00               	LDA		#0				
  1303 0000FC2F 60                  	RTS
  1304 0000FC30                     L_FrameError?:
  1305 0000FC30 A9 01               	LDA		#1
  1306 0000FC32 60                  	RTS
  1307 0000FC33                     L_ParityError?:
  1308 0000FC33 A9 02               	LDA		#2
  1309 0000FC35 60                  	RTS	
  1310 0000FC36                     L_BreakError?:
  1311 0000FC36 A9 03               	LDA		#3
  1312 0000FC38 60                  	RTS		
  1313 0000FC39                     L_OverrunError?:
  1314 0000FC39 A9 04               	LDA		#4
  1315 0000FC3B 60                  	RTS
  1316                              	
  1317                              ; =======================================================================================
  1318                              ; Function name : IsUARTBusy
  1319                              ; Purpose       : Check UART Busy Flag
  1320                              ; Parameter     : None
  1321                              ; Return        : A :0:Idle, others:Busy
  1322                              ; Destroy       : A 
  1323                              ; ======================================================================================    
  1324 0000FC3C                     IsUARTBusy:
  1325 0000FC3C                     _IsUARTBusy:
  1326 0000FC3C 8D 0B 30            	STA		P_WDT_Clear
  1327 0000FC3F AD 57 31                LDA     P_UART_Status2
  1328 0000FC42 29 08                   AND     #D_UARTBusy
  1329 0000FC44 D0 F6                   BNE		IsUARTBusy
  1330 0000FC46 60                      RTS	
