  1161                              ; Function name : F_UART_Initial
  1162                              ; Purpose       : Initial UART H/W
  1163                              ; Parameter     : R_UART_Baudrate
  1164                              ; Return        : None
  1165                              ; Destroy       : A
  1166                              ; ======================================================================================
  1167 0000FB88                     F_UART_Initial:
  1168 0000FB88                     _F_UART_Initial:
  1169                              	
  1170                              
  1171                              ;	R_UART_CNT = 0x00;
  1172                              ;	R_UARTRX_Status = 0xFF;
  1173                              ;	F_Clear_buffs();
  1174                              ;	/* Add your code here */
  1175                              ;	R_UART_Baudrate = 0x02; //115200hz		
  1176 0000FB88 A9 00               	LDA		#00
  1177 0000FB8A 8D D6 02            	STA		R_UART_CNT
  1178 0000FB8D A9 FF               	LDA		#0xff
  1179 0000FB8F 8D D5 02            	STA		R_UARTRX_Status
  1180 0000FB92 A9 09               	LDA		#0x09
  1181 0000FB94 8D D4 02            	STA		R_UART_Baudrate
  1182                              ;
  1183                              	
  1184 0000FB97 A9 58               	LDA		#D_UARTReset+D_UARTEn+D_UARTTxIntEn;+D_UARTRxTimeoutIntEn
  1185 0000FB99 8D 52 31            	STA		P_UART_Ctrl1
  1186                              
  1187 0000FB9C A9 70               	LDA		#D_UARTStopBit1+D_UARTFIFOEn+D_UARTDataBit8	;	D_UARTParityEn+D_UARTParityOdd+
  1188 0000FB9E 8D 53 31            	STA		P_UART_Ctrl2
  1189                              	
  1190 0000FBA1 AD D4 02            	LDA		R_UART_Baudrate
  1191 0000FBA4 20 A8 FB            	JSR		F_UART_Baudrate
  1192                              
  1193                              
  1194 0000FBA7 60                  	RTS
