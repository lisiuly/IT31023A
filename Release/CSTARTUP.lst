  1030                              ;=====================================================================
  1031                              	_P_BANK_Sel:				.EQU	P_BANK_Sel
  1032                              	
  1033                              	INS_SRC_ADDR_L:				.EQU 0x00	; low addr of source
  1034                              	INS_SRC_ADDR_H:				.EQU 0x01	; high addr of source
  1035                              	
  1036                              	INS_SRC_SIZE_L:				.EQU 0x02	; low size of source
  1037                              	INS_SRC_SIZE_H:				.EQU 0x03	; high size of source
  1038                              	
  1039                              	INS_DES_ADDR_L:				.EQU 0x04	; low addr of destination
  1040                              	INS_DES_ADDR_H:				.EQU 0x05	; high addr of destination
  1041                              
  1042                              	INS_INIT_TAB_SIZE:			.EQU 0x06	; size of INIT_TAB
  1043                              	
  1044                              	TEMPCOUNT_SIZE_H:			.EQU 0x07	
  1045                              	OFFSET_INIT_TAB:			.EQU 0x08
  1046                              	
  1047                              	TAB_RCRD_SIZE:				.EQU 0x7	; record size in init table
