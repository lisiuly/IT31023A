  1057 0000C001 A2 FF               	LDX	#0xFF				; set up stack pointer
  1058 0000C003 9A                  	TXS
  1059                              ;=====================================================================
  1060                              ; Call __low_level_init to perform initialization 
  1061                              ; before initializing segments and calling main.
  1062                              ; If the function returns 0 no segment initialization should take place.
  1063                              ; Link with your own version of __low_level_init 
  1064                              ; to override the default action: to do nothing but return 1.
  1065                              ;=====================================================================	
  1066 0000C004 20 A0 C7            	JSR	_low_level_init
  1067 0000C007 A8                  	TAY						; test return value
  1068 0000C008 D0 03               	BNE seg_init
  1069 0000C00A 4C 81 C0            	JMP seg_init_end		; ready to execute GSINIT
  1070                              ;=====================================================================	
  1071                              ; Copy initialized PROMmed code to shadow RAM and clear
  1072                              ; uninitialized variables.
  1073                              ;=====================================================================	
  1074 0000C00D                     seg_init:					; seg_init() start
  1075                              
  1076                              ;=======================================
  1077                              ; Copy N_CDATA into N_IDATA (option)
