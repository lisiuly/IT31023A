   774                      <       ;**********************************************************************
   775                      <       ;ROM Checksum
   776                      <       ;**********************************************************************
   777                      <       .IF (GPL815P04Ax)
   778                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5, 0x8000 ~ 0xBFFF
   779                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   780                      <       ;				   
   781                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   782                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   783                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0xBFFF:User ROM Code
   784                      <       	D_Bank0HUserRomEndAddr:			.EQU	0xBFFF	
   785                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   786                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   787                      <       .ENDIF
   788                      <       
   789                      <       .IF (GPL815P04Ax_16KB)
   790                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5
   791                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   792                      <       ;				   
   793                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   794                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   795                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   796                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   797                      <       .ENDIF	
   798                      <       
   799                      <       .IF (GPL815P04Bx)
   800                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5, 0x8000 ~ 0xBFFF (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   801                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   802                      <       ;				   
   803                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   804                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   805                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0xBFFF:User ROM Code
   806                      <       	D_Bank0HUserRomEndAddr:			.EQU	0xBFFF	
   807                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   808                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   809                      <       .ENDIF	
   810                      <       
   811                      <       .IF (GPL815P04Bx_15KB)
   812                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5 (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   813                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   814                      <       ;				   
   815                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   816                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   817                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   818                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   819                      <       .ENDIF
   820                      <       
   821                      <       .IF (GPL815P03Ax)
   822                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5, 0x8000 ~ 0x9FFF
   823                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   824                      <       ;				   
   825                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   826                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   827                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0x9FFF:User ROM Code
   828                      <       	D_Bank0HUserRomEndAddr:			.EQU	0x9FFF	
   829                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   830                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD
   831                      <       .ENDIF
   832                      <       
   833                      <       .IF (GPL815P03Bx)
   834                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5, 0x8000 ~ 0x9FFF (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   835                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   836                      <       ;				   
   837                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   838                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   839                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0x9FFF:User ROM Code
   840                      <       	D_Bank0HUserRomEndAddr:			.EQU	0x9FFF	
   841                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   842                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD
   843                      <       .ENDIF	
   844                      <       
   845                      <       .IF (GPL815P02Ax)
   846                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5
   847                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   848                      <       ;				   
   849                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   850                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   851                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   852                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   853                      <       .ENDIF	
   854                      <       ; ========================================================================================
   855                      <       ; Macro Name	: M_UserRomChecksum
   856                      <       ; Parameters	: None
   857                      <       ; Return Value	: R_ChecksumResult: bit[7:0]
   858                      <       ;				: R_ChecksumResult + 1: bit[15:8]
   859                      <       ;				: R_ChecksumResult + 2: bit[23:16]
   860                      <       ;				: R_ChecksumResult + 3: bit[31:24]
   861                      <       ; Description	: Calculate user ROM area code checksum
   862                      <       ; Destroy		: A, X
   863                      <       ; Example		: %M_UserRomChecksum	R_ChecksumAddrPtr, R_ChecksumResult
   864                      <       ; ========================================================================================	
   865                      <       %M_UserRomChecksum:	.MACRO	R_ChecksumAddrPtr, R_ChecksumResult
   866                      <       	LDA		#0
   867                      <       	STA		R_ChecksumResult					;Result Byte0
   868                      <       	STA		R_ChecksumResult + 1				;Result Byte1
   869                      <       	STA		R_ChecksumResult + 2				;Result Byte2
   870                      <       	STA		R_ChecksumResult + 3				;Result Byte3
   871                      <       ;=================== Bank 0 ==================================================	
   872                      <       	LDA		#.HIGH.D_Bank0UserRomStartAddr
   873                      <       	STA		R_ChecksumAddrPtr + 1				;Start High Byte
   874                      <       	LDA		#.LOW.D_Bank0UserRomStartAddr
   875                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   876                      <       		
   877                      <       	LDY		#0	
   878                      <       
   879                      <       L_ChecksumLoop1?
   880                      <       	STA	   P_WDT_Clear	
   881                      <       	CLC
   882                      <       	LDA		(R_ChecksumAddrPtr),Y
   883                      <       	ADC		R_ChecksumResult					;Result Low Byte
   884                      <       	STA		R_ChecksumResult					;Result Low Byte
   885                      <       	BCC		L_CheckAddress1?
   886                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   887                      <       	BNE		L_CheckAddress1?
   888                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   889                      <       	BNE		L_CheckAddress1?
   890                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   891                      <       		
   892                      <       L_CheckAddress1?:
   893                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   894                      <       	CMP		#.HIGH.D_Bank0UserRomEndAddr		;End High Byte
   895                      <       	BNE		L_IncreaseAdd1?
   896                      <       	
   897                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   898                      <       	CMP		#.LOW.D_Bank0UserRomEndAddr			;End Low Byte
   899                      <       	BEQ		L_ExitRomSum1?
   900                      <       	
   901                      <       L_IncreaseAdd1?:
   902                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   903                      <       	BNE		L_ChecksumLoop1?
   904                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   905                      <       	JMP		L_ChecksumLoop1?	
   906                      <       		
   907                      <       L_ExitRomSum1?:		
   908                      <       .IF (GPL815P04Ax+GPL815P04Bx+GPL815P03Ax+GPL815P03Bx)	
   909                      <       ;===================================Bank0H==============================================
   910                      <       	LDA		#.HIGH.D_Bank0HUserRomStartAddr
   911                      <       	STA		R_ChecksumAddrPtr + 1				;Start High Byte
   912                      <       	LDA		#.LOW.D_Bank0HUserRomStartAddr
   913                      <       	STA		R_ChecksumAddrPtr
   914                      <       	
   915                      <       L_ChecksumLoop1H?
   916                      <       	STA	   P_WDT_Clear	
   917                      <       	CLC
   918                      <       	LDA		(R_ChecksumAddrPtr),Y
   919                      <       	ADC		R_ChecksumResult					;Result Low Byte
   920                      <       	STA		R_ChecksumResult					;Result Low Byte
   921                      <       	BCC		L_CheckAddress1H?
   922                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   923                      <       	BNE		L_CheckAddress1H?
   924                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   925                      <       	BNE		L_CheckAddress1H?
   926                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   927                      <       		
   928                      <       L_CheckAddress1H?:
   929                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   930                      <       	CMP		#.HIGH.D_Bank0HUserRomEndAddr		;End High Byte
   931                      <       	BNE		L_IncreaseAdd1H?
   932                      <       	
   933                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   934                      <       	CMP		#.LOW.D_Bank0HUserRomEndAddr			;End Low Byte
   935                      <       	BEQ		L_ExitRomSum1H?
   936                      <       	
   937                      <       L_IncreaseAdd1H?:
   938                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   939                      <       	BNE		L_ChecksumLoop1H?
   940                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   941                      <       	JMP		L_ChecksumLoop1H?	
   942                      <       		
   943                      <       L_ExitRomSum1H?:	
   944                      <       .ENDIF	
   945                      <       ;===================NMI & Reset Vector==================================================		
   946                      <       	LDA		#.HIGH.D_NMIandResetVectorStartAddr
   947                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   948                      <       	LDA		#.LOW.D_NMIandResetVectorStartAddr
   949                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   950                      <       		
   951                      <       L_ChecksumLoop2?
   952                      <       	STA	   P_WDT_Clear		
   953                      <       	CLC
   954                      <       	LDA		(R_ChecksumAddrPtr),Y
   955                      <       	ADC		R_ChecksumResult					;Result Low Byte
   956                      <       	STA		R_ChecksumResult					;Result Low Byte
   957                      <       	BCC		L_CheckAddress2?
   958                      <       	INC		R_ChecksumResult + 1				;Result Byte2
   959                      <       	BNE		L_CheckAddress2?
   960                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   961                      <       	BNE		L_CheckAddress2?
   962                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   963                      <       		
   964                      <       L_CheckAddress2?:
   965                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   966                      <       	CMP		#.HIGH.D_NMIandResetVectorEndAddr	;End High Byte
   967                      <       	BNE		L_IncreaseAdd2?
   968                      <       	
   969                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   970                      <       	CMP		#.LOW.D_NMIandResetVectorEndAddr	;End Low Byte
   971                      <       	BEQ		L_ExitRomSum2?
   972                      <       	
   973                      <       L_IncreaseAdd2?:
   974                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   975                      <       	BNE		L_ChecksumLoop2?
   976                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   977                      <       	JMP		L_ChecksumLoop2?	
   978                      <       		
   979                      <       L_ExitRomSum2?:	
   980                      <       	.ENDM
   981                      <       
   982                      <       	.ENDIF
   983                      <       .endif
   984                      <       	.ENDIF	
   985                      <       
