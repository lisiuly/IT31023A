   990                              ; Initial types:
   991                              	INIT_NPAGE:			.DEFL 1				; Initial the NPAGE data
   992                              ; Actions after main():
   993                              ;	HINT: please setup only 'ONE' of the followings.
   994                              	LOOP_AT_END:		.DEFL 1				; Endless waiting after main()
   995                              	SW_BRK:				.DEFL 0				; Entering SBK instruction
   996                              	HW_HALT:			.DEFL 0				; Exception of invalid instruction
