  1080                              ; Read the size of INIT_TAB
  1081 0000C00D A9 00               	LDA	#.HIGH8.GPSizeOf_INIT_TAB
  1082 0000C00F 8D 00 30            	STA	P_BANK_Sel
  1083 0000C012 A9 07                	LDA #.LOW.GPSizeOf_INIT_TAB
  1084 0000C014 85 06                	STA INS_INIT_TAB_SIZE
  1085 0000C016 F0 10               	BEQ skip5
  1086 0000C018 A2 00               	LDX #0x00
  1087 0000C01A 86 08               	STX OFFSET_INIT_TAB			; support up to 36 (=255/7) initial xdata sections
  1088 0000C01C                     loop5:
  1089                              ; Copy N_CDATA into N_IDATA according to the INIT_TAB's record
  1090 0000C01C 20 30 C0            	JSR _copy_mem
  1091 0000C01F                     skip6:
