  1093 0000C01F A5 06               	LDA	INS_INIT_TAB_SIZE
  1094 0000C021 38                  	SEC
  1095 0000C022 E9 07               	SBC	#TAB_RCRD_SIZE
  1096 0000C024 85 06               	STA	INS_INIT_TAB_SIZE
  1097 0000C026 D0 F4               	BNE	loop5
  1098 0000C028                     skip5:
  1099 0000C028 A9 00               	LDA	#.HIGH8.__program_startup
  1100 0000C02A 8D 00 30            	STA P_BANK_Sel					; save bank ID to _P_BANK_Sel
  1101 0000C02D 4C 81 C0            	JMP seg_init_end				; ready to execute GSINIT
  1102                              		
  1103 0000C030                     _copy_mem:
  1104                              ; Load rescord in INIT_TAB
  1105                              ; Setup start address of des
  1106 0000C030 A6 08               	LDX OFFSET_INIT_TAB
  1107 0000C032 BD B1 C1            	LDA GPAddressOf_INIT_TAB, X		; load des's low addr
  1108 0000C035 85 04               	STA INS_DES_ADDR_L
  1109 0000C037 E8                  	INX
  1110 0000C038 BD B1 C1            	LDA GPAddressOf_INIT_TAB, X		; load des's high addr
  1111 0000C03B 85 05               	STA INS_DES_ADDR_H
  1112                              ; Setup start address of source
  1113 0000C03D E8                  	INX
  1114 0000C03E BD B1 C1            	LDA GPAddressOf_INIT_TAB, X		; load src's low addr
  1115 0000C041 85 00               	STA INS_SRC_ADDR_L
  1116 0000C043 E8                  	INX
  1117 0000C044 BD B1 C1            	LDA GPAddressOf_INIT_TAB, X		; load src's high addr
  1118 0000C047 85 01               	STA INS_SRC_ADDR_H
  1119 0000C049 E8                  	INX
  1120 0000C04A BD B1 C1            	LDA GPAddressOf_INIT_TAB, X		; load bank ID
  1121 0000C04D 8D 00 30            	STA  P_BANK_Sel				; save bank ID to _P_BANK_Sel
  1122 0000C050 E8                  	INX
  1123                              ; Setup size of source
  1124 0000C051 BD B1 C1            	LDA GPAddressOf_INIT_TAB, X		; load src's low size
  1125 0000C054 85 02               	STA INS_SRC_SIZE_L
  1126 0000C056 E8                  	INX
  1127 0000C057 BD B1 C1            	LDA GPAddressOf_INIT_TAB, X		; load src's high size
  1128 0000C05A 85 03               	STA INS_SRC_SIZE_H
  1129 0000C05C E8                  	INX
  1130 0000C05D 86 08               	STX OFFSET_INIT_TAB
  1131                              ; Start copy
  1132 0000C05F A9 00               	LDA #0x00
  1133 0000C061 A8                  	TAY
  1134 0000C062 A6 03               	LDX INS_SRC_SIZE_H				; copy blocks
  1135 0000C064 F0 0E               	BEQ skip7
  1136 0000C066                     loop6:
  1137 0000C066 B1 00               	LDA (INS_SRC_ADDR_L), Y
  1138 0000C068 91 04               	STA (INS_DES_ADDR_L), Y
  1139 0000C06A C8                  	INY
  1140 0000C06B D0 F9               	BNE loop6
  1141 0000C06D E6 01               	INC INS_SRC_ADDR_H
  1142 0000C06F E6 05               	INC INS_DES_ADDR_H
  1143 0000C071 CA                  	DEX
  1144 0000C072 D0 F2               	BNE loop6
  1145 0000C074                     skip7:
  1146 0000C074 A6 02               	LDX INS_SRC_SIZE_L				; copy the rest
  1147 0000C076 F0 08               	BEQ skip8
  1148 0000C078                     loop7:
  1149 0000C078 B1 00               	LDA (INS_SRC_ADDR_L), Y
  1150 0000C07A 91 04               	STA (INS_DES_ADDR_L), Y
  1151 0000C07C C8                  	INY
  1152 0000C07D CA                  	DEX
  1153 0000C07E D0 F8               	BNE loop7
  1154 0000C080                     skip8:
  1155 0000C080 60                  	RTS
  1156                              .ENDIF
