   803                      <       ;**********************************************************************
   804                      <       ;ROM Checksum
   805                      <       ;**********************************************************************
   806                      <       .IF (GPL815P04Ax)
   807                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5, 0x8000 ~ 0xBFFF
   808                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   809                      <       ;				   
   810                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   811                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   812                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0xBFFF:User ROM Code
   813                      <       	D_Bank0HUserRomEndAddr:			.EQU	0xBFFF	
   814                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   815                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   816                      <       .ENDIF
   817                      <       
   818                      <       .IF (GPL815P04Ax_16KB)
   819                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5
   820                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   821                      <       ;				   
   822                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   823                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   824                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   825                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   826                      <       .ENDIF	
   827                      <       
   828                      <       .IF (GPL815P04Bx)
   829                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5, 0x8000 ~ 0xBFFF (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   830                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   831                      <       ;				   
   832                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   833                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   834                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0xBFFF:User ROM Code
   835                      <       	D_Bank0HUserRomEndAddr:			.EQU	0xBFFF	
   836                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   837                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   838                      <       .ENDIF	
   839                      <       
   840                      <       .IF (GPL815P04Bx_15KB)
   841                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5 (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   842                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   843                      <       ;				   
   844                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   845                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   846                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   847                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   848                      <       .ENDIF
   849                      <       
   850                      <       .IF (GPL815P03Ax)
   851                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5, 0x8000 ~ 0x9FFF
   852                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   853                      <       ;				   
   854                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   855                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   856                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0x9FFF:User ROM Code
   857                      <       	D_Bank0HUserRomEndAddr:			.EQU	0x9FFF	
   858                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   859                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD
   860                      <       .ENDIF
   861                      <       
   862                      <       .IF (GPL815P03Bx)
   863                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5, 0x8000 ~ 0x9FFF (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   864                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   865                      <       ;				   
   866                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   867                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   868                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0x9FFF:User ROM Code
   869                      <       	D_Bank0HUserRomEndAddr:			.EQU	0x9FFF	
   870                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   871                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD
   872                      <       .ENDIF	
   873                      <       
   874                      <       .IF (GPL815P02Ax)
   875                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5
   876                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   877                      <       ;				   
   878                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   879                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   880                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   881                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   882                      <       .ENDIF	
   883                      <       ; ========================================================================================
   884                      <       ; Macro Name	: M_UserRomChecksum
   885                      <       ; Parameters	: None
   886                      <       ; Return Value	: R_ChecksumResult: bit[7:0]
   887                      <       ;				: R_ChecksumResult + 1: bit[15:8]
   888                      <       ;				: R_ChecksumResult + 2: bit[23:16]
   889                      <       ;				: R_ChecksumResult + 3: bit[31:24]
   890                      <       ; Description	: Calculate user ROM area code checksum
   891                      <       ; Destroy		: A, X
   892                      <       ; Example		: %M_UserRomChecksum	R_ChecksumAddrPtr, R_ChecksumResult
   893                      <       ; ========================================================================================	
   894                      <       %M_UserRomChecksum:	.MACRO	R_ChecksumAddrPtr, R_ChecksumResult
   895                      <       	LDA		#0
   896                      <       	STA		R_ChecksumResult					;Result Byte0
   897                      <       	STA		R_ChecksumResult + 1				;Result Byte1
   898                      <       	STA		R_ChecksumResult + 2				;Result Byte2
   899                      <       	STA		R_ChecksumResult + 3				;Result Byte3
   900                      <       ;=================== Bank 0 ==================================================	
   901                      <       	LDA		#.HIGH.D_Bank0UserRomStartAddr
   902                      <       	STA		R_ChecksumAddrPtr + 1				;Start High Byte
   903                      <       	LDA		#.LOW.D_Bank0UserRomStartAddr
   904                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   905                      <       		
   906                      <       	LDY		#0	
   907                      <       
   908                      <       L_ChecksumLoop1?
   909                      <       	STA	   P_WDT_Clear	
   910                      <       	CLC
   911                      <       	LDA		(R_ChecksumAddrPtr),Y
   912                      <       	ADC		R_ChecksumResult					;Result Low Byte
   913                      <       	STA		R_ChecksumResult					;Result Low Byte
   914                      <       	BCC		L_CheckAddress1?
   915                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   916                      <       	BNE		L_CheckAddress1?
   917                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   918                      <       	BNE		L_CheckAddress1?
   919                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   920                      <       		
   921                      <       L_CheckAddress1?:
   922                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   923                      <       	CMP		#.HIGH.D_Bank0UserRomEndAddr		;End High Byte
   924                      <       	BNE		L_IncreaseAdd1?
   925                      <       	
   926                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   927                      <       	CMP		#.LOW.D_Bank0UserRomEndAddr			;End Low Byte
   928                      <       	BEQ		L_ExitRomSum1?
   929                      <       	
   930                      <       L_IncreaseAdd1?:
   931                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   932                      <       	BNE		L_ChecksumLoop1?
   933                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   934                      <       	JMP		L_ChecksumLoop1?	
   935                      <       		
   936                      <       L_ExitRomSum1?:		
   937                      <       .IF (GPL815P04Ax+GPL815P04Bx+GPL815P03Ax+GPL815P03Bx)	
   938                      <       ;===================================Bank0H==============================================
   939                      <       	LDA		#.HIGH.D_Bank0HUserRomStartAddr
   940                      <       	STA		R_ChecksumAddrPtr + 1				;Start High Byte
   941                      <       	LDA		#.LOW.D_Bank0HUserRomStartAddr
   942                      <       	STA		R_ChecksumAddrPtr
   943                      <       	
   944                      <       L_ChecksumLoop1H?
   945                      <       	STA	   P_WDT_Clear	
   946                      <       	CLC
   947                      <       	LDA		(R_ChecksumAddrPtr),Y
   948                      <       	ADC		R_ChecksumResult					;Result Low Byte
   949                      <       	STA		R_ChecksumResult					;Result Low Byte
   950                      <       	BCC		L_CheckAddress1H?
   951                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   952                      <       	BNE		L_CheckAddress1H?
   953                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   954                      <       	BNE		L_CheckAddress1H?
   955                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   956                      <       		
   957                      <       L_CheckAddress1H?:
   958                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   959                      <       	CMP		#.HIGH.D_Bank0HUserRomEndAddr		;End High Byte
   960                      <       	BNE		L_IncreaseAdd1H?
   961                      <       	
   962                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   963                      <       	CMP		#.LOW.D_Bank0HUserRomEndAddr			;End Low Byte
   964                      <       	BEQ		L_ExitRomSum1H?
   965                      <       	
   966                      <       L_IncreaseAdd1H?:
   967                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   968                      <       	BNE		L_ChecksumLoop1H?
   969                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   970                      <       	JMP		L_ChecksumLoop1H?	
   971                      <       		
   972                      <       L_ExitRomSum1H?:	
   973                      <       .ENDIF	
   974                      <       ;===================NMI & Reset Vector==================================================		
   975                      <       	LDA		#.HIGH.D_NMIandResetVectorStartAddr
   976                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   977                      <       	LDA		#.LOW.D_NMIandResetVectorStartAddr
   978                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   979                      <       		
   980                      <       L_ChecksumLoop2?
   981                      <       	STA	   P_WDT_Clear		
   982                      <       	CLC
   983                      <       	LDA		(R_ChecksumAddrPtr),Y
   984                      <       	ADC		R_ChecksumResult					;Result Low Byte
   985                      <       	STA		R_ChecksumResult					;Result Low Byte
   986                      <       	BCC		L_CheckAddress2?
   987                      <       	INC		R_ChecksumResult + 1				;Result Byte2
   988                      <       	BNE		L_CheckAddress2?
   989                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   990                      <       	BNE		L_CheckAddress2?
   991                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   992                      <       		
   993                      <       L_CheckAddress2?:
   994                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   995                      <       	CMP		#.HIGH.D_NMIandResetVectorEndAddr	;End High Byte
   996                      <       	BNE		L_IncreaseAdd2?
   997                      <       	
   998                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   999                      <       	CMP		#.LOW.D_NMIandResetVectorEndAddr	;End Low Byte
  1000                      <       	BEQ		L_ExitRomSum2?
  1001                      <       	
  1002                      <       L_IncreaseAdd2?:
  1003                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
  1004                      <       	BNE		L_ChecksumLoop2?
  1005                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
  1006                      <       	JMP		L_ChecksumLoop2?	
  1007                      <       		
  1008                      <       L_ExitRomSum2?:	
  1009                      <       	.ENDM
  1010                      <       
  1011                      <       	.ENDIF
  1012                      <       .endif
  1013                      <       	.ENDIF	
