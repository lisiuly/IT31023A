   729                      <       	D_PWMIO0En:						.EQU	00000001B
   730                      <       	D_PWMIO1En:						.EQU	00000010B
   731                      <       	D_PWMIO2En:						.EQU	00000100B	
   732                      <       	D_PWMIO3En:						.EQU	00001000B	
   733                      <       	D_PWMClkSysClk:					.EQU	00000000B
   734                      <       	D_PWMClkSysClk8:				.EQU	00010000B	
   735                      <       	D_PWMClkSysClk64:				.EQU	00100000B	
   736                      <       	D_PWMClk32K:					.EQU	00110000B
   737                      <       	D_PWMClkTM0:					.EQU	01000000B
   738                      <       	D_PWMClkTM1:					.EQU	01010000B	
   739                      <       	D_PWMClkRFCTM0:					.EQU	01100000B		
   740                      <       	D_PWMClkRFCTM1:					.EQU	01110000B	
   741                      <       
   742                      <       P_PWMIO_Sel:                    .EQU    P_PWMIO_Ctrl_Base+0x01  ;$0x3491
   743                      <       P_PWMIO_Timer_Data:				.EQU    P_PWMIO_Ctrl_Base+0x02  ;$0x3492
   744                      <       P_PWMIO_Timer_Cnt:				.EQU    P_PWMIO_Ctrl_Base+0x03  ;$0x3493
   745                      <       			
   746                      <       P_PWMIO_IO0_DUTY:               .EQU    P_PWMIO_Ctrl_Base+0x04  ;$0x3494
   747                      <       P_PWMIO_IO1_DUTY:               .EQU    P_PWMIO_Ctrl_Base+0x05  ;$0x3495
   748                      <       P_PWMIO_IO2_DUTY:               .EQU    P_PWMIO_Ctrl_Base+0x06  ;$0x3496
   749                      <       P_PWMIO_IO3_DUTY:               .EQU    P_PWMIO_Ctrl_Base+0x07  ;$0x3497
   750                      <       
