   756                      <       P_RFC_Ctrl1:       				.EQU    P_RFC_Ctrl_Base+0x01  ;$0x34C1
   757                      <       	D_AutoStop:						.EQU	01000000B
   758                      <       	D_RFCEn:						.EQU	00010000B	
   759                      <       	D_RFCStart:						.EQU	00000001B	
   760                      <       
   761                      <       P_RFC_Timer_Ctrl:       		.EQU    P_RFC_Ctrl_Base+0x03  ;$0x34C3
   762                      <       	D_RFCTM0En:						.EQU	00000001B
   763                      <       	D_RFCTM1En:						.EQU	00000010B
   764                      <       	D_RFCTM0ClkMask:				.EQU	00011100B
   765                      <       	D_RFCTM0ClkStop:				.EQU	00000000B
   766                      <       	D_RFCTM0ClkIO:					.EQU	00000100B
   767                      <       	D_RFCTM0ClkSysClk:				.EQU	00001100B
   768                      <       	D_RFCTM0ClkSysClk2:				.EQU	00010000B
   769                      <       	D_RFCTM0ClkRFC1:				.EQU	00010100B
   770                      <       	D_RFCTM0ClkRFC2:				.EQU	00011000B
   771                      <       	D_RFCTM0Clk32K:					.EQU	00011100B
   772                      <       	
   773                      <       	D_RFCTM1ClkMask:				.EQU	11100000B
   774                      <       	D_RFCTM1ClkStop:				.EQU	00000000B
   775                      <       	D_RFCTM1ClkSysClk:				.EQU	00100000B
   776                      <       	D_RFCTM1ClkSysClk2:				.EQU	01000000B
   777                      <       	D_RFCTM1ClkSysClk4:				.EQU	01100000B
   778                      <       	D_RFCTM1ClkSysClk8:				.EQU	10000000B
   779                      <       	D_RFCTM1ClkSysClk16:			.EQU	10100000B
   780                      <       	D_RFCTM1ClkSysClk32:			.EQU	11000000B
   781                      <       	D_RFCTM1Clk32K:					.EQU	11100000B
   782                      <       	
   783                      <       P_RFC_Ctrl2:       				.EQU    P_RFC_Ctrl_Base+0x04  ;$0x34C4
   784                      <       	D_RFCCaptureEdgeRising:			.EQU	00000000B
   785                      <       	D_RFCCaptureEdgeFalling:		.EQU	00000100B		
   786                      <       	D_RFCCaptureTrigDis:			.EQU	00000000B	
   787                      <       	D_RFCCaptureTrigTM0:			.EQU	00000001B	
   788                      <       	
