  2838 0000F126                     F_ADC_BCDADC:
  2839 0000F126 AA                  			TAX
  2840 0000F127 18                  			CLC
  2841 0000F128 69 01               			ADC		#C_Bit_0
  2842 0000F12A 29 0F               			AND		#C_HideHigh
  2843 0000F12C C9 0A               			CMP		#0AH
  2844 0000F12E 90 02               			BCC		?L_HighNebble_Change
  2845 0000F130 A9 00               			LDA		#00h
  2846 0000F132                     ?L_HighNebble_Change:
  2847 0000F132 85 32               			STA		R_KEYMathTemp
  2848 0000F134 8A                  			TXA
  2849 0000F135 90 02               			BCC		?L_No_Caryy
  2850 0000F137 69 10               			ADC		#C_Bit_4
  2851 0000F139                     ?L_No_Caryy:		
  2852 0000F139 29 F0               			AND		#C_HideLow
  2853 0000F13B C9 70               			CMP		#70H		;#60h
  2854 0000F13D 90 02               			BCC		?L_ChangeOk
  2855 0000F13F A9 00               			LDA		#00h
  2856 0000F141                     ?L_ChangeOk:
  2857 0000F141 45 32               			EOR		R_KEYMathTemp			; when >=a0h,c=1 
  2858 0000F143 60                  			RTS
