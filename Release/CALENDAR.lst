   790                      <       P_RFC_TM0Data_HB:       		.EQU    P_RFC_Ctrl_Base+0x07  ;$0x34C7
   791                      <       P_RFC_TM0Cnt_LB:       			.EQU    P_RFC_Ctrl_Base+0x08  ;$0x34C8
   792                      <       P_RFC_TM0Cnt_HB:       			.EQU    P_RFC_Ctrl_Base+0x09  ;$0x34C9
   793                      <       
   794                      <       P_RFC_TM1Data_LB:       		.EQU    P_RFC_Ctrl_Base+0x0A  ;$0x34CA
   795                      <       P_RFC_TM1Data_HB:       		.EQU    P_RFC_Ctrl_Base+0x0B  ;$0x34CB
   796                      <       P_RFC_TM1Cnt_LB:				.EQU    P_RFC_Ctrl_Base+0x0C  ;$0x34CC
   797                      <       P_RFC_TM1Cnt_HB:       			.EQU    P_RFC_Ctrl_Base+0x0D  ;$0x34CD
   798                      <       
   799                      <       P_RFC_TM1CapData_LB:       		.EQU    P_RFC_Ctrl_Base+0x0E  ;$0x34CE
   800                      <       P_RFC_TM1CapData_HB:		  	.EQU    P_RFC_Ctrl_Base+0x0F  ;$0x34CF
