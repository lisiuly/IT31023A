   690                      <       	D_LCDclk32K:					.EQU	00000000B
   691                      <       	D_LCDclk16K:					.EQU	00010000B
   692                      <       	D_LCDclk8K:						.EQU	00100000B	
   693                      <       	D_LCDclk4K:						.EQU	00110000B	
   694                      <       
   695                      <       P_LCD_SEG_Num:					.EQU    P_LCD_Ctrl_Base+0x03    ;$0x3453
   696                      <       	D_32SEG:						.EQU	00000011B	
   697                      <       	D_48SEG:						.EQU	00000101B
   698                      <       	
   699                      <       P_LCD_COM_Num:					.EQU    P_LCD_Ctrl_Base+0x04    ;$0x3454	
   700                      <       	D_5COM:							.EQU	00000100B	
   701                      <       	D_9COM:							.EQU	00001000B
   702                      <       	
   703                      <       P_LCD_FM_Ctrl:					.EQU    P_LCD_Ctrl_Base+0x05    ;$0x3455
   704                      <       	D_LCDBType:						.EQU	00000000B
   705                      <       	D_LCDCType:						.EQU	10000000B	
   706                      <       	
   707                      <       P_LCD_VLCD_Ctrl:                .EQU    P_LCD_Ctrl_Base+0x06    ;$0x3456
   708                      <       
   709                      <       P_LCD_PUMP_Ctrl:                .EQU    P_LCD_Ctrl_Base+0x07    ;$0x3457
   710                      <       	D_PumpClk2K:					.EQU	00000000B
   711                      <       	D_PumpClk4K:					.EQU	00000001B
   712                      <       	D_PumpClk8K:					.EQU	00000010B
   713                      <       	D_PumpClk16K:					.EQU	00000011B	
   714                      <       	D_PumpEn:						.EQU	10000000B
   715                      <       	
   716                      <       P_LCD_BIAS_Ctrl:                .EQU    P_LCD_Ctrl_Base+0x08    ;$0x3458
   717                      <       	D_LCDBias4:						.EQU	00000001B
   718                      <       	D_LCDBias3:						.EQU	00000010B
   719                      <       	D_LCDBias2:						.EQU	00000011B
   720                      <       	
