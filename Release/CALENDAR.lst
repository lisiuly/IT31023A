  3087 0000F163                     F_CheckAlarm:					;检查闹钟是否打开
  3088                              ;	jsr		Disable_Alarm
  3089 0000F163 AD 74 00            	LDA		R_TimeFlashSet
  3090 0000F166 0D 75 00            	ORA		R_AlmTimeFlashSet
  3091 0000F169 0D 76 00            	ORA		R_TimerFlashSet
  3092 0000F16C D0 04               	BNE		?Exit				;有设置界面打开则不检查闹钟	
  3093 0000F16E A5 2E               	LDA		R_AlarmOnOff
  3094 0000F170 D0 01               	BNE		$+3				;有闹钟打开，则去比较闹钟时间与当前时间
  3095 0000F172                     	?Exit:
  3096 0000F172 60                  		RTS
  3097 0000F173 A2 00               		LDX		#0		
  3098                              ;;------------------------------------------------	
  3099 0000F175                     F_EnCheckAlarm:
  3100 0000F175 A5 2E               		LDA     R_AlarmOnOff         ; 加载闹钟启用状态
  3101 0000F177 20 AA F1            		JSR     CheckAlarmEnabled             ; 测试第X位是否设置
  3102 0000F17A F0 1E               		BEQ     ?L_NextAlarm           ; 未启用则跳过	
  3103                              		
  3104 0000F17C B5 27               		LDA		R_AlarmHour	,x
  3105 0000F17E 45 23               		EOR		R_DateHour		
  3106 0000F180 D0 18               		BNE		?L_NextAlarm		;判断小时
  3107 0000F182 B5 24               		LDA		R_AlarmMinute	,x
  3108 0000F184 45 22               		EOR		R_DateMinute
  3109 0000F186 D0 12               		BNE		?L_NextAlarm		;判断分
  3110 0000F188 86 2A               	    STX     R_CurrentGroup      ; 保存当前组号
  3111 0000F18A 20 B0 F1                   JSR     F_CheckAlarmDayType ; 调用天数类型检查（C=1触发）	
  3112 0000F18D 90 0B                      BCC     ?L_NextAlarm         ; 天数类型不匹配则跳过
  3113 0000F18F 20 F3 F1            		JSR		L_LoadAlarming		;闹钟响
  3114 0000F192 A9 00               		LDA		#0
  3115 0000F194 8D 77 00            		STA		R_SleepTime
  3116 0000F197 4C 9F F1            		JMP     ?L_SleepSnooze
  3117 0000F19A                     	?L_NextAlarm:					;闹钟时间没到
  3118 0000F19A E8                  		INX
  3119 0000F19B E0 03               	    CPX #3
  3120 0000F19D 90 D6                  	BCC F_EnCheckAlarm
  3121 0000F19F                        ?L_SleepSnooze: 	; 贪睡状态检查
  3122                              
  3123 0000F19F AD 73 00            	 	LDA R_OtherFlag
  3124 0000F1A2 29 04               		AND	#D_EnableSnooze
  3125 0000F1A4 F0 03               		BEQ	$+5		
  3126 0000F1A6 20 0D F2            		JSR	F_CheckSnoozeAlarm
  3127 0000F1A9 60                  		RTS
  3128                              		
  3129                              ; 输入：X = 闹钟组号 (0-2)
  3130                              ; 输出：Z=1 表示未启用，Z=0 表示启用
  3131 0000F1AA                     CheckAlarmEnabled:
  3132 0000F1AA BD DD F6               LDA BitMaskTable,X   ; 获取对应位掩码
  3133 0000F1AD 25 2E                  AND R_AlarmOnOff     ; 与启用状态寄存器相与
  3134 0000F1AF 60                     RTS                  ; 结果在 A 中，Z 标志位表示是否启用	
  3135                              .PUBLIC		F_CheckAlarmDayType		
