  1170                      <       LCDConvert		.MACRO  com,seg
  1171                      <       			DB	com*10H+(seg/8)+00H,1<<(seg.AND.07H)	;GPL813P01;
  1172                      <       			
  1173                      <       			.ENDM
  1174                      <       			
  1175                      <       %LCD7S        .MACRO   i1c,i1s,i2c,i2s,i3c,i3s,i4c,i4s,i5c,i5s,i6c,i6s,i7c,i7s
  1176                      <                      LCDConvert    i1c,i1s
  1177                      <                      LCDConvert    i2c,i2s
  1178                      <                      LCDConvert    i3c,i3s
  1179                      <                      LCDConvert    i4c,i4s
  1180                      <                      LCDConvert    i5c,i5s
  1181                      <                      LCDConvert    i6c,i6s
  1182                      <                      LCDConvert    i7c,i7s
  1183                      <                      .ENDM
  1184                      <                      
  1185                      <       %LCD8S:        .MACRO   i1c,i1s,i2c,i2s,i3c,i3s,i4c,i4s,i5c,i5s,i6c,i6s,i7c,i7s,i8c,i8s
  1186                      <                      LCDConvert    i1c,i1s
  1187                      <                      LCDConvert    i2c,i2s
  1188                      <                      LCDConvert    i3c,i3s
  1189                      <                      LCDConvert    i4c,i4s
  1190                      <                      LCDConvert    i5c,i5s
  1191                      <                      LCDConvert    i6c,i6s
  1192                      <                      LCDConvert    i7c,i7s
  1193                      <       		       LCDConvert    i8c,i8s
  1194                      <                      .ENDM  
  1195                      <       ;;================================================================
  1196                      <       ;Kind   :Count Loop
  1197                      <       ;================================================================		                    
  1198                      <       %DJNZ:               .MACRO       Var,Lable    ;  !=0
  1199                      <                             DEC          Var
  1200                      <                             BNE          Lable
  1201                      <                            .ENDM
  1202                      <       		
  1203                      <       ;----------------------------------------------------------
  1204                      <       ;/***********************************************/
  1205                      <       ;         i.L=1 
  1206                      <       %bits:   .MACRO   i,L             ;BYTE i;  
  1207                      <                 lda     i               ;ex.  
  1208                      <                 ora     #L              ;  %bits 10H,_BIT0
  1209                      <       		                   ;  10H.0=1
  1210                      <                 sta     i               ;
  1211                      <                .ENDM    
  1212                      <       
  1213                      <       ;/***********************************************/
  1214                      <       ;         i.L=0
  1215                      <       %bitr:   .MACRO   i,L             ;BYTE i;  
  1216                      <                 lda     i               ;ex.  
  1217                      <                 and     #.NOT.L         ;  %bitr 10H,_BIT0;  10H.0=0
  1218                      <                 sta     i
  1219                      <                .ENDM    
  1220                      <       
  1221                      <       ;/***********************************************/
  1222                      <       ;         if(i.L==1) goto N
  1223                      <       %btst:   .MACRO   i,L,N           ;BYTE i;  
  1224                      <                 lda     i               ;ex.   
  1225                      <                 and     #L              ;  %btst 10H,_BIT0,N
  1226                      <                 bne     N               ;  if(10H.0=1) goto N 
  1227                      <                .ENDM    
  1228                      <                                         
  1229                      <       ;/***********************************************/
  1230                      <       ;         if(i.L==0) goto N
  1231                      <       %btsf:   .MACRO   i,L,N           ;BYTE i;    
  1232                      <                 lda     i               ;ex.   
  1233                      <                 and     #L              ;  %btsf 10H,_BIT0,N
  1234                      <                 beq     N               ;  if(10H.0=0) goto N 
  1235                      <                .ENDM    
