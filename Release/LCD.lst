  3806 0000D001 20 14 D0            		JSR		F_Hex_To_BCD
  3807 0000D004 A0 09               		LDY		#09h
  3808 0000D006 20 3D D0            		JSR		F_Disp_Digital		
  3809 0000D009 A6 34               		LDX		R_TimerSecond
  3810 0000D00B 20 14 D0            		JSR		F_Hex_To_BCD
