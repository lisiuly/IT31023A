  3941 0000D089 85 58               		STA		R_Temp2
  3942                              		
  3943                              		
  3944 0000D08B E6 59                		INC		R_Temp3
  3945 0000D08D D0 02               		BNE		L_DispByte_1
  3946 0000D08F E6 5A               		INC		R_Temp4
  3947 0000D091                      L_DispByte_1:
  3948 0000D091 A2 00               		LDX		#00H
  3949 0000D093 A1 59               		LDA		(R_Temp3,X)
  3950 0000D095 85 56               		STA		R_Temp0
  3951 0000D097 E6 59                		INC		R_Temp3
  3952 0000D099 D0 02               		BNE		L_DispByte_1_0
  3953 0000D09B E6 5A               		INC		R_Temp4
  3954 0000D09D                      L_DispByte_1_0:
  3955 0000D09D A1 59               		LDA		(R_Temp3,X)
  3956 0000D09F E6 59               		INC		R_Temp3
  3957 0000D0A1 D0 02               		BNE		L_DispByte_1_1
  3958 0000D0A3 E6 5A               		INC		R_Temp4
  3959 0000D0A5                      L_DispByte_1_1:
