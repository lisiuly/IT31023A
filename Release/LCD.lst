  3935 0000D07F C9 3F               		CMP		#3fh
  3936 0000D081 F0 48               		BEQ		L_Not_show_0
  3937 0000D083 A2 00               		LDX		#00H
  3938 0000D085 A1 59               		LDA		(R_Temp3,X)
  3939 0000D087                      ?L_Sta_temp2:
