  3977 0000D0BF BD 00 20            		LDA	$2000,X
  3978 0000D0C2 05 56               		ORA	R_Temp0
  3979 0000D0C4 9D 00 20            		STA	$2000,X	
  3980 0000D0C7 C6 58               		DEC		R_Temp2
  3981 0000D0C9 D0 C6               		BNE		L_DispByte_1
