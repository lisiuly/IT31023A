  2337                      <       ;%LCD7S        .MACRO   i1c,i1s,i2c,i2s,i3c,i3s,i4c,i4s,i5c,i5s,i6c,i6s,i7c,i7s
  2338                      <       ;               LCDConvert    i1c,i1s
  2339                      <       ;               LCDConvert    i2c,i2s
  2340                      <       ;               LCDConvert    i3c,i3s
  2341                      <       ;               LCDConvert    i4c,i4s
  2342                      <       ;               LCDConvert    i5c,i5s
  2343                      <       ;               LCDConvert    i6c,i6s
  2344                      <       ;               LCDConvert    i7c,i7s
  2345                      <       ;               .ENDM
  2346                      <       ;               
  2347                      <       ;%LCD8S:        .MACRO   i1c,i1s,i2c,i2s,i3c,i3s,i4c,i4s,i5c,i5s,i6c,i6s,i7c,i7s,i8c,i8s
  2348                      <       ;               LCDConvert    i1c,i1s
  2349                      <       ;               LCDConvert    i2c,i2s
  2350                      <       ;               LCDConvert    i3c,i3s
  2351                      <       ;               LCDConvert    i4c,i4s
  2352                      <       ;               LCDConvert    i5c,i5s
  2353                      <       ;               LCDConvert    i6c,i6s
