  3725                              ;====data==============
  3726 0000CFA8                     F_SWatch_Modul:
  3727                                  ; 1. 检查是正计时还是倒计时
  3728                                  %btst R_TimerFlag, D_Timerstatus_just, ?L_Check_CountUp
  3729 0000CFA8 AD 83 00          1           lda     R_TimerFlag               ;ex.   
  3730 0000CFAB 29 01             1           and     #D_Timerstatus_just              ;  %btst 10H,_BIT0,N
  3731 0000CFAD D0 12             1           bne     ?L_Check_CountUp               ;  if(10H.0=1) goto N 
  3732                              
  3733                                  ; ===========================
  3734                                  ; 倒计时模式处理 (Count Down)
  3735                                  ; ===========================
  3736                                  ; 1. 显示 T_Timer 图标 (常亮)
  3737 0000CFAF A2 06                   LDX #T_Timer
  3738 0000CFB1 20 CC D0                JSR F_DispFlag
  3739                                  
  3740                                  ; 2. 不显示 T_TimerUp 图标
  3741 0000CFB4 A2 08                   LDX #T_TimerUp
  3742 0000CFB6 20 77 D1                JSR F_NotDispFlag
  3743                                  
  3744                                  ; 3. 显示 T_TCol 冒号 (常亮，不闪烁)
  3745 0000CFB9 A2 04                   LDX #T_TCol
  3746 0000CFBB 20 CC D0                JSR F_DispFlag
  3747                                  
  3748 0000CFBE 4C E5 CF                JMP ?L_Common_Process
  3749                              
  3750 0000CFC1                     ?L_Check_CountUp:
  3751                                  ; ===========================
  3752                                  ; 正计时模式处理 (Count Up)
  3753                                  ; ===========================
  3754                                  ; 1. 不显示 T_Timer 图标
  3755 0000CFC1 A2 06                   LDX #T_Timer
  3756 0000CFC3 20 77 D1                JSR F_NotDispFlag
  3757                                  
  3758                                  ; 2. 显示 T_TimerUp 图标 (常亮)
  3759 0000CFC6 A2 08                   LDX #T_TimerUp
  3760 0000CFC8 20 CC D0                JSR F_DispFlag
  3761                                  
  3762                                  ; 3. 冒号闪烁处理
  3763                                  ; 检查是否处于暂停状态 (D_Timerstatus_justpause)
  3764                                  %btst R_TimerFlag, D_Timerstatus_justpause, ?L_Col_On ; 暂停时常亮
  3765 0000CFCB AD 83 00          1           lda     R_TimerFlag               ;ex.   
  3766 0000CFCE 29 10             1           and     #D_Timerstatus_justpause              ;  %btst 10H,_BIT0,N
  3767 0000CFD0 D0 06             1           bne     ?L_Col_On               ;  if(10H.0=1) goto N 
  3768                                  
  3769                                  ; 正常走时，检查是否闪烁 (通过 R_flash_Temp 控制)
  3770 0000CFD2 A9 01                   LDA #01H
  3771 0000CFD4 24 5F                   BIT R_flash_Temp
  3772 0000CFD6 D0 08                   BNE ?L_Col_Off
  3773                                  
  3774 0000CFD8                     ?L_Col_On:
  3775 0000CFD8 A2 04                   LDX #T_TCol
  3776 0000CFDA 20 CC D0                JSR F_DispFlag
  3777 0000CFDD 4C E5 CF                JMP ?L_Common_Process
  3778                              
  3779 0000CFE0                     ?L_Col_Off:
  3780 0000CFE0 A2 04                   LDX #T_TCol
  3781 0000CFE2 20 77 D1                JSR F_NotDispFlag
  3782                              
  3783 0000CFE5                     ?L_Common_Process:
  3784                                  ; ===========================
  3785                                  ; 公共处理部分 (计算显示点数)
  3786                                  ; ===========================
  3787 0000CFE5 A5 33               	    LDA R_TimerMinute
  3788 0000CFE7 85 5D                       STA R_LCD32Temp     
  3789                                      
  3790 0000CFE9 A5 33                       LDA R_TimerMinute
  3791 0000CFEB 05 34                       ORA R_TimerSecond
  3792 0000CFED F0 08                       BEQ ?L_TimeEnd      
  3793                                      
  3794 0000CFEF A5 5D                       LDA R_LCD32Temp
  3795 0000CFF1 18                          CLC
  3796 0000CFF2 69 01                       ADC #01H
  3797 0000CFF4 4C F9 CF                    JMP ?L_DoDisplay
  3798                                      
  3799 0000CFF7                     ?L_TimeEnd:
  3800 0000CFF7 A9 00                       LDA #00H            
