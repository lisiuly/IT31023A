  3369                              ;==========================================
  3370                              ; 查找最近闹钟（复用R_CurrentGroup和R_TempBuf）
  3371                              ;==========================================
  3372 0000CE57                     FindNearestAlarm:
  3373 0000CE57 A9 FF               	lda #0xFF
  3374 0000CE59 85 2A                 	STA R_CurrentGroup      ; 初始化为无效值
  3375                              
  3376 0000CE5B A2 00                	ldx #0                  ; 遍历组0→1→2 			
  3377 0000CE5D                      GroupLoop:
  3378                              	; --- 检查闹钟是否开启 ---
  3379 0000CE5D BD DD F6            	lda BitMaskTable,x      ; 复用组掩码表
  3380 0000CE60 25 2E               	and R_AlarmOnOff
  3381 0000CE62 F0 22               	beq ?SkipToNextGroup 
  3382                              
  3383                              	; --- 检查星期匹配
  3384 0000CE64 8E CC 02            	stx R_TempBuf+0           ; 临时存储组号
  3385 0000CE67 B5 2B               	lda R_DispAlmDay,x
  3386 0000CE69 20 B0 F1            	jsr F_CheckAlarmDayType ; 你的现有函数
  3387 0000CE6C AE CC 02            	ldx R_TempBuf+0           ; 恢复组号
  3388 0000CE6F 90 76               	bcc ?NextGroup
  3389                              
  3390                                  ; --- 时间调整逻辑（处理次日情况）---
  3391 0000CE71 B5 27                   lda R_AlarmHour,x
  3392 0000CE73 C5 23                   cmp R_DateHour                   ; 比较当前小时
  3393 0000CE75 90 12                   bcc ?Adjust24                 ; 闹钟小时 < 当前小时 → 调整
  3394 0000CE77 D0 08                   bne ?NoAdjust                 ; 闹钟小时 > 当前小时 → 不调整
  3395                              
  3396 0000CE79 B5 24                   lda R_AlarmMinute,x             ; 小时相等时检查分钟
  3397 0000CE7B C5 22                   cmp R_DateMinute
  3398 0000CE7D 90 0A                   bcc ?Adjust24                 ; 闹钟分钟 < 当前分钟 → 调整
  3399 0000CE7F F0 08                   beq ?Adjust24                 ; 等于当前时间 → 调整
  3400 0000CE81                      ?NoAdjust:
  3401 0000CE81 B5 27                   lda R_AlarmHour,x
  3402 0000CE83 4C 8E CE                jmp ?StoreHour
  3403                                  
  3404 0000CE86                       ?SkipToNextGroup:
  3405 0000CE86 4C E7 CE              	JMP ?NextGroup
  3406                                	
  3407 0000CE89                      ?Adjust24:
  3408 0000CE89 B5 27                   lda R_AlarmHour,x
  3409 0000CE8B 18                      clc
  3410 0000CE8C 69 24                   adc #36                     ; 加24小时处理次日
  3411                              
  3412 0000CE8E                      ?StoreHour:
  3413 0000CE8E 8D CD 02                sta R_TempBuf+1              ; 存储调整后小时
  3414 0000CE91 B5 24                   lda R_AlarmMinute,x
  3415 0000CE93 8D CE 02                sta R_TempBuf+2              ; 存储原始分钟
  3416                              
  3417                                  ; --- 时间有效性检查 ---
  3418 0000CE96 AD CD 02                lda R_TempBuf+1
  3419 0000CE99 C5 23                   cmp R_DateHour
  3420 0000CE9B 90 4A                   bcc ?NextGroup                ; 调整后时间仍早于当前时间 → 无效
  3421 0000CE9D D0 07                   bne ?ValidTime                ; 调整后小时 > 当前小时 → 有效
  3422                              
  3423 0000CE9F AD CE 02                lda R_TempBuf+2              ; 小时相等时比较分钟
  3424 0000CEA2 C5 22                   cmp	R_DateMinute
  3425                               ;   beq ?NextGroup                ; 时间完全相同 → 已过期
  3426 0000CEA4 90 41                   bcc ?NextGroup                ; 分钟仍小于当前 → 无效
  3427                              
  3428 0000CEA6                      ?ValidTime:
  3429                                  ; --- 更新最近组逻辑 ---
  3430 0000CEA6 A4 2A                   ldy R_CurrentGroup
  3431 0000CEA8 C0 FF                   cpy #0xFF
  3432 0000CEAA F0 36                   beq ?UpdateGroup
  3433                              
  3434                                  ; Recalculate stored group's adjusted hour
  3435 0000CEAC B9 27 00                lda R_AlarmHour,y
  3436 0000CEAF C5 23                   cmp R_DateHour
  3437 0000CEB1 90 11                   bcc ?Adjust24_Stored
  3438 0000CEB3 D0 09                   bne ?NoAdjust_Stored
  3439 0000CEB5 B9 24 00                lda R_AlarmMinute,y
  3440 0000CEB8 C5 22                   cmp R_DateMinute
  3441 0000CEBA 90 08                   bcc ?Adjust24_Stored
  3442 0000CEBC F0 06                   beq ?Adjust24_Stored
  3443 0000CEBE                      ?NoAdjust_Stored:
  3444 0000CEBE B9 27 00                lda R_AlarmHour,y
  3445 0000CEC1 4C CA CE                jmp ?Compare_Hours
  3446 0000CEC4                      ?Adjust24_Stored:
  3447 0000CEC4 B9 27 00                lda R_AlarmHour,y
  3448 0000CEC7 18                      clc
  3449 0000CEC8 69 24                   adc #36
  3450 0000CECA                      ?Compare_Hours:
  3451                                  ; 比较调整后小时（A寄存器=已存储组调整后小时，R_TempBuf+1=当前组调整后小时）
  3452 0000CECA CD CD 02                cmp R_TempBuf+1
  3453 0000CECD 90 18                   bcc ?NextGroup           ; 已存储组调整后小时 < 当前组 → 保留已存储组
  3454 0000CECF D0 11                   bne ?UpdateGroup         ; 已存储组调整后小时 > 当前组 → 更新为当前组
  3455                              
  3456                                  ; 小时相同 → 比较原始分钟
  3457 0000CED1 AD CE 02                lda R_TempBuf+2          ; 当前组原始分钟
  3458 0000CED4 D9 24 00                cmp R_AlarmMinute,y         ; 已存储组原始分钟
  3459 0000CED7 90 09                   bcc ?UpdateGroup         ; 当前组分钟 < 已存储组 → 更新（更早）
  3460 0000CED9 D0 0C                   bne ?NextGroup           ; 当前组分钟 > 已存储 → 保留
  3461                              
  3462                                  ; --- 分钟相同 → 比较组号 ---
  3463 0000CEDB AD CC 02                lda R_TempBuf+0          ; 当前组号 (TempBuf+0)
  3464 0000CEDE C5 2A                   cmp R_CurrentGroup       ; 已存储组号 (y寄存器)
  3465 0000CEE0 B0 05                   bcs ?NextGroup           ; 当前组号 ≥ 已存储 → 保留已存储组
  3466                                  
  3467 0000CEE2                      ?UpdateGroup:
  3468 0000CEE2 AE CC 02                ldx R_TempBuf+0
  3469 0000CEE5 86 2A                   stx R_CurrentGroup
  3470                              
  3471 0000CEE7                      ?NextGroup:
  3472 0000CEE7 E8                      inx
  3473 0000CEE8 E0 03                   cpx #3
  3474 0000CEEA B0 03                   bcs ?ExitLoop
  3475 0000CEEC 4C 5D CE                jmp GroupLoop
  3476 0000CEEF                      ?ExitLoop:
  3477 0000CEEF A5 2A                   lda R_CurrentGroup
  3478 0000CEF1 C9 FF                   cmp #0xFF
  3479 0000CEF3 D0 04                   bne ?L_Exit
  3480 0000CEF5 A9 00                   lda #0                       ; 默认返回组0
  3481 0000CEF7 85 2A                   sta R_CurrentGroup
  3482 0000CEF9                      ?L_Exit:	
  3483 0000CEF9 60                  	rts
