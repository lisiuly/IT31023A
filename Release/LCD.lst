  2607                              ; ==============================================
  2608                              ; Function: F_Disp_SpeakIcon
  2609                              ; Purpose : 根据 R_OtherFlag 中的 D_Urat_Open 和 R_Uart_OpenTime 控制
  2610                              ;           T_Speak 图标：若 D_Urat_Open=1 则显示；当 R_Uart_OpenTime <=5 时闪烁
  2611                              ; Params  : none (uses globals)
  2612                              ; Return  : none
  2613                              ; Destroy : A, X
  2614                              ; ==============================================
  2615 0000CA52                     F_Disp_SpeakIcon:
  2616 0000CA52 AD 73 00            	LDA	R_OtherFlag
  2617 0000CA55 29 02               	AND	#D_Urat_Open
  2618 0000CA57 F0 17               	BEQ	?Speak_Hide		; 若没有打开语音则隐藏图标
  2619                              
  2620                              	; 若打开语音，检查剩余时间是否小于等于5，若是则闪烁
  2621 0000CA59 AD 8C 00            	LDA	R_Uart_OpenTime
  2622 0000CA5C C9 05               	CMP	#5
  2623 0000CA5E B0 0A               	BCS	?Speak_Show_Steady	; >=5 则常显
  2624                              
  2625                              	; 闪烁（受 R_flash_Temp 控制）
  2626 0000CA60 A5 5F               	LDA	R_flash_Temp
  2627 0000CA62 F0 0C               	BEQ	?Speak_Hide
  2628 0000CA64 A2 18               	LDX	#T_Speak
  2629 0000CA66 20 CC D0            	JSR	F_DispFlag
  2630 0000CA69 60                  	RTS
  2631                              
  2632 0000CA6A                     ?Speak_Show_Steady:
  2633 0000CA6A A2 18               	LDX	#T_Speak
  2634 0000CA6C 20 CC D0            	JSR	F_DispFlag
  2635 0000CA6F 60                  	RTS
  2636                              
  2637 0000CA70                     ?Speak_Hide:
  2638 0000CA70 A2 18               	LDX	#T_Speak
  2639 0000CA72 20 77 D1            	JSR	F_NotDispFlag
  2640 0000CA75 60                  	RTS
