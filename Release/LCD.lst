  2357                      <       ;;================================================================
  2358                      <       ;Kind   :Count Loop
  2359                      <       ;================================================================		                    
  2360                      <       %DJNZ:               .MACRO       Var,Lable    ;  !=0
  2361                      <                             DEC          Var
  2362                      <                             BNE          Lable
  2363                      <                            .ENDM
  2364                      <       		
  2365                      <       ;----------------------------------------------------------
  2366                      <       ;/***********************************************/
  2367                      <       ;         i.L=1 
  2368                      <       %bits:   .MACRO   i,L             ;BYTE i;  
  2369                      <                 lda     i               ;ex.  
  2370                      <                 ora     #L              ;  %bits 10H,_BIT0
  2371                      <       		                   ;  10H.0=1
  2372                      <                 sta     i               ;
  2373                      <                .ENDM    
  2374                      <       
  2375                      <       ;/***********************************************/
  2376                      <       ;         i.L=0
  2377                      <       %bitr:   .MACRO   i,L             ;BYTE i;  
  2378                      <                 lda     i               ;ex.  
  2379                      <                 and     #.NOT.L         ;  %bitr 10H,_BIT0;  10H.0=0
  2380                      <                 sta     i
  2381                      <                .ENDM    
  2382                      <       
  2383                      <       ;/***********************************************/
  2384                      <       ;         if(i.L==1) goto N
  2385                      <       %btst:   .MACRO   i,L,N           ;BYTE i;  
  2386                      <                 lda     i               ;ex.   
  2387                      <                 and     #L              ;  %btst 10H,_BIT0,N
  2388                      <                 bne     N               ;  if(10H.0=1) goto N 
  2389                      <                .ENDM    
  2390                      <                                         
  2391                      <       ;/***********************************************/
  2392                      <       ;         if(i.L==0) goto N
  2393                      <       %btsf:   .MACRO   i,L,N           ;BYTE i;    
  2394                      <                 lda     i               ;ex.   
  2395                      <                 and     #L              ;  %btsf 10H,_BIT0,N
  2396                      <                 beq     N               ;  if(10H.0=0) goto N 
  2397                      <                .ENDM    
