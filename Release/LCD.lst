  2468                              ;;============================================================================
  2469                              ;Name:			F_SeetupDisplay_Proc
  2470                              ;Purpose:		LCD display service
  2471                              ;Parameters:	None
  2472                              ;Destroy:		A,X,Y
  2473                              ;Stack depth:	2 bytes
  2474                              ;============================================================================
  2475 0000C997                     F_SeetupDisplay_Proc:		;设置模式
  2476 0000C997                     _F_SeetupDisplay_Proc:
  2477                              			%btst	RB_Lcd_Updata_Flag,D_LcdUpdate,?Update_Time_All
  2478 0000C997 A5 5E             1           lda     RB_Lcd_Updata_Flag               ;ex.   
  2479 0000C999 29 40             1           and     #D_LcdUpdate              ;  %btst 10H,_BIT0,N
  2480 0000C99B D0 13             1           bne     ?Update_Time_All               ;  if(10H.0=1) goto N 
  2481                              			%btst	R_KeyFlag,D_EnableFastAdd,?Update_Time_All	;判断是否需要更新所有时间的显示
  2482 0000C99D AD 71 00          1           lda     R_KeyFlag               ;ex.   
  2483 0000C9A0 29 01             1           and     #D_EnableFastAdd              ;  %btst 10H,_BIT0,N
  2484 0000C9A2 D0 0C             1           bne     ?Update_Time_All               ;  if(10H.0=1) goto N 
  2485                              			%btst	R_flash_Temp,AddOthers,?NoDisp_SetValue
  2486 0000C9A4 A5 5F             1           lda     R_flash_Temp               ;ex.   
  2487 0000C9A6 29 01             1           and     #AddOthers              ;  %btst 10H,_BIT0,N
  2488 0000C9A8 D0 09             1           bne     ?NoDisp_SetValue               ;  if(10H.0=1) goto N 
  2489                              			%bits	RB_Lcd_Updata_Flag,D_LcdUpdate
