  3827 0000D016 85 60               	STA		R_MathTemp
  3828 0000D018                      ?LOOP0#:
  3829 0000D018 8A                  	TXA
  3830 0000D019 C9 0A               	CMP		#0AH
  3831 0000D01B B0 06               	BCS		?DEC10#
  3832 0000D01D 18                  	CLC
  3833 0000D01E 65 60               	ADC		R_MathTemp
  3834 0000D020 85 60               	STA		R_MathTemp
  3835                              	;TAX
  3836 0000D022 60                  	RTS
  3837 0000D023                      ?DEC10#:
  3838 0000D023 E9 0A               	SBC		#0AH
  3839 0000D025 AA                  	TAX
  3840 0000D026 A9 10               	LDA		#10H
  3841 0000D028 18                  	CLC
  3842 0000D029 65 60               	ADC		R_MathTemp
  3843 0000D02B 85 60               	STA		R_MathTemp
  3844 0000D02D 4C 18 D0            	JMP		?LOOP0#
  3845 0000D030                      ?L_Hex_To_BCD_END#:
  3846 0000D030 60                  	RTS	
