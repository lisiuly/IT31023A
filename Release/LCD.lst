  3961 0000D0A7 66 57               		ROR		R_Temp1
  3962 0000D0A9 B0 12               		BCS		L_DispByte_1_1_1
  3963 0000D0AB                      L_DispByte_1_1_0:
  3964 0000D0AB EA                  		NOP
  3965                              ;		%F_ClearByteBit
  3966 0000D0AC 85 56               		STA	R_Temp0
  3967 0000D0AE BD 00 20            		LDA	$2000,X
  3968 0000D0B1 05 56               		ORA	R_Temp0
  3969 0000D0B3 45 56               		EOR	R_Temp0
  3970 0000D0B5 9D 00 20            		STA	$2000,X
  3971 0000D0B8 C6 58               		DEC		R_Temp2
  3972 0000D0BA D0 D5               		BNE		L_DispByte_1
  3973 0000D0BC 60                  		RTS	
  3974 0000D0BD                      L_DispByte_1_1_1:
