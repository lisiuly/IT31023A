  2298                      <       ;X:byte index. A:mask bit
  2299                      <       ; ==============================================
  2300                      <       ; Macro name	: %F_SetByteBit 
  2301                      <       ; Purpose	    : set BYTE Bit
  2302                      <       ; Parameter		: A,X
  2303                      <       ; Return    	: 
  2304                      <       ; Destroy	    : 
  2305                      <       ; Stack depth	: 2
  2306                      <       ; ==============================================
  2307                      <       %F_SetByteBit: .MACRO
  2308                      <       		STA		R_Temp0
  2309                      <       		LDA		R_LcdBuff,X			; use buffer directly
  2310                      <       		ORA		R_Temp0
  2311                      <       		STA		R_LcdBuff,X
  2312                      <       		.ENDM
  2313                      <       ;======
  2314                      <       ;X:byte index. A:mask bit
  2315                      <       ; ==============================================
  2316                      <       ; Macro name	: %F_ClearByteBit 
  2317                      <       ; Purpose	    : Clear BYTE Bit
  2318                      <       ; Parameter		: A,X
  2319                      <       ; Return    	: 
  2320                      <       ; Destroy	    : 
  2321                      <       ; Stack depth	: 2
  2322                      <       ; ==============================================
  2323                      <       %F_ClearByteBit: .MACRO
  2324                      <       		STA		R_Temp0
  2325                      <       		LDA		R_LcdBuff,X			; use buffer directly
  2326                      <       		ORA		R_Temp0
  2327                      <       		EOR		R_Temp0
  2328                      <       		STA		R_LcdBuff,X
  2329                      <       		.ENDM
