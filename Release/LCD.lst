  2402                              ; Function	name: F_Flash_COL_Dot 
  2403                              ; Purpose	    : Make a dot flash 
  2404                              ; Parameter		: X
  2405                              ; Return    	: 
  2406                              ; Destroy	    : 
  2407                              ; Stack depth	: 2
  2408                              ; =============================================		
  2409 0000C94D                     F_Flash_COL_Dot:		
  2410 0000C94D                     _F_Flash_COL_Dot:
  2411 0000C94D EA                  		NOP
  2412 0000C94E A9 01               		LDA		#01H
  2413 0000C950 24 5F               		BIT		R_flash_Temp
  2414 0000C952 D0 06               		BNE		?L_Not_show_col
  2415 0000C954                      ?L_Flash:		
  2416 0000C954 A2 00               		LDX		#T_Col
  2417 0000C956 20 CC D0            		JSR		F_DispFlag
  2418 0000C959 60                  		RTS
  2419 0000C95A                      ?L_Not_show_col:
  2420 0000C95A A2 00               		LDX		#T_Col
  2421 0000C95C 20 77 D1            		JSR		F_NotDispFlag		;col vu
  2422 0000C95F 60                  		RTS
  2423                              		
  2424                              ; ==============================================
  2425                              ; Function	name: F_LCD_Initinal 
  2426                              ; Purpose	    : Make a dot flash 
  2427                              ; Parameter		: X
  2428                              ; Return    	: 
  2429                              ; Destroy	    : 
  2430                              ; Stack depth	: 2
  2431                              ; =============================================		
  2432 0000C960                     F_LCD_Initinal:
  2433 0000C960                     _F_LCD_Initinal:
  2434 0000C960 A9 02                 LDA #D_LCDBias3
  2435 0000C962 8D 58 34              STA P_LCD_BIAS_Ctrl       ; 设置LCD偏置电压
  2436                                
  2437 0000C965 A9 82                 LDA #D_PumpEn+D_PumpClk8K
  2438 0000C967 8D 57 34              STA P_LCD_PUMP_Ctrl       ; 启用电荷泵(8KHz)
  2439                                
  2440 0000C96A A9 07                 LDA #(((8192/80))/(D_6COM+1))-D_48SEG-5
  2441 0000C96C 8D 52 34              STA P_LCD_Clock           ; 设置LCD时钟频率
  2442 0000C96F A9 00                 LDA		#00h
  2443 0000C971 8D 51 34              STA		P_LCD_Ctrl2
  2444                              	
  2445 0000C974 A9 05                 LDA #D_6COM
  2446 0000C976 8D 54 34              STA P_LCD_COM_Num         ; 5COM线配置
  2447 0000C979 A9 05                 LDA #D_48SEG
  2448 0000C97B 8D 53 34              STA P_LCD_SEG_Num         ; 48SEG线配置
  2449                                
  2450 0000C97E A9 0F                 LDA #0Fh
  2451 0000C980 8D 56 34              STA P_LCD_VLCD_Ctrl       ;，VLCD=4.5V
  2452                                
  2453                                ; 延时等待电荷泵稳定
  2454 0000C983 38                    SEC
  2455 0000C984 A9 FF                 LDA #0xff
  2456 0000C986                      L_Delay?:
  2457 0000C986 E9 01                 SBC #0x01
  2458 0000C988 EA                    NOP
  2459 0000C989 EA                    NOP
  2460 0000C98A D0 FA                 BNE L_Delay?
  2461                                
  2462 0000C98C A9 00                 LDA #00h
  2463 0000C98E 8D 59 34              STA P_LCD_StartAddr_LB    ; 设置起始地址
  2464 0000C991 A9 88                 LDA #D_LCDEn+D_DisplayOn
  2465 0000C993 8D 50 34              STA P_LCD_Ctrl1           ; 启用LCD显示
  2466 0000C996 60                    RTS
