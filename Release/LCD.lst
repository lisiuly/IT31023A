  3928 0000D075 30 02               		BMI		?L_Check_80_8x
  3929 0000D077 10 0E               		BPL		?L_Sta_temp2
  3930 0000D079                      ?L_Check_80_8x:
  3931 0000D079 29 07               		AND		#07h
