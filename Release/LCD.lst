   805                      <       ;**********************************************************************
   806                      <       ;ROM Checksum
   807                      <       ;**********************************************************************
   808                      <       .IF (GPL815P04Ax)
   809                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5, 0x8000 ~ 0xBFFF
   810                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   811                      <       ;				   
   812                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   813                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   814                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0xBFFF:User ROM Code
   815                      <       	D_Bank0HUserRomEndAddr:			.EQU	0xBFFF	
   816                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   817                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   818                      <       .ENDIF
   819                      <       
   820                      <       .IF (GPL815P04Ax_16KB)
   821                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5
   822                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   823                      <       ;				   
   824                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   825                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   826                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   827                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   828                      <       .ENDIF	
   829                      <       
   830                      <       .IF (GPL815P04Bx)
   831                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5, 0x8000 ~ 0xBFFF (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   832                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   833                      <       ;				   
   834                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   835                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   836                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0xBFFF:User ROM Code
   837                      <       	D_Bank0HUserRomEndAddr:			.EQU	0xBFFF	
   838                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   839                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   840                      <       .ENDIF	
   841                      <       
   842                      <       .IF (GPL815P04Bx_15KB)
   843                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5 (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   844                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   845                      <       ;				   
   846                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   847                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   848                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   849                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   850                      <       .ENDIF
   851                      <       
   852                      <       .IF (GPL815P03Ax)
   853                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5, 0x8000 ~ 0x9FFF
   854                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   855                      <       ;				   
   856                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   857                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   858                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0x9FFF:User ROM Code
   859                      <       	D_Bank0HUserRomEndAddr:			.EQU	0x9FFF	
   860                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   861                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD
   862                      <       .ENDIF
   863                      <       
   864                      <       .IF (GPL815P03Bx)
   865                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5, 0x8000 ~ 0x9FFF (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   866                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   867                      <       ;				   
   868                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   869                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   870                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0x9FFF:User ROM Code
   871                      <       	D_Bank0HUserRomEndAddr:			.EQU	0x9FFF	
   872                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   873                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD
   874                      <       .ENDIF	
   875                      <       
   876                      <       .IF (GPL815P02Ax)
   877                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5
   878                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   879                      <       ;				   
   880                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   881                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   882                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   883                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   884                      <       .ENDIF	
   885                      <       ; ========================================================================================
   886                      <       ; Macro Name	: M_UserRomChecksum
   887                      <       ; Parameters	: None
   888                      <       ; Return Value	: R_ChecksumResult: bit[7:0]
   889                      <       ;				: R_ChecksumResult + 1: bit[15:8]
   890                      <       ;				: R_ChecksumResult + 2: bit[23:16]
   891                      <       ;				: R_ChecksumResult + 3: bit[31:24]
   892                      <       ; Description	: Calculate user ROM area code checksum
   893                      <       ; Destroy		: A, X
   894                      <       ; Example		: %M_UserRomChecksum	R_ChecksumAddrPtr, R_ChecksumResult
   895                      <       ; ========================================================================================	
   896                      <       %M_UserRomChecksum:	.MACRO	R_ChecksumAddrPtr, R_ChecksumResult
   897                      <       	LDA		#0
   898                      <       	STA		R_ChecksumResult					;Result Byte0
   899                      <       	STA		R_ChecksumResult + 1				;Result Byte1
   900                      <       	STA		R_ChecksumResult + 2				;Result Byte2
   901                      <       	STA		R_ChecksumResult + 3				;Result Byte3
   902                      <       ;=================== Bank 0 ==================================================	
   903                      <       	LDA		#.HIGH.D_Bank0UserRomStartAddr
   904                      <       	STA		R_ChecksumAddrPtr + 1				;Start High Byte
   905                      <       	LDA		#.LOW.D_Bank0UserRomStartAddr
   906                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   907                      <       		
   908                      <       	LDY		#0	
   909                      <       
   910                      <       L_ChecksumLoop1?
   911                      <       	STA	   P_WDT_Clear	
   912                      <       	CLC
   913                      <       	LDA		(R_ChecksumAddrPtr),Y
   914                      <       	ADC		R_ChecksumResult					;Result Low Byte
   915                      <       	STA		R_ChecksumResult					;Result Low Byte
   916                      <       	BCC		L_CheckAddress1?
   917                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   918                      <       	BNE		L_CheckAddress1?
   919                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   920                      <       	BNE		L_CheckAddress1?
   921                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   922                      <       		
   923                      <       L_CheckAddress1?:
   924                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   925                      <       	CMP		#.HIGH.D_Bank0UserRomEndAddr		;End High Byte
   926                      <       	BNE		L_IncreaseAdd1?
   927                      <       	
   928                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   929                      <       	CMP		#.LOW.D_Bank0UserRomEndAddr			;End Low Byte
   930                      <       	BEQ		L_ExitRomSum1?
   931                      <       	
   932                      <       L_IncreaseAdd1?:
   933                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   934                      <       	BNE		L_ChecksumLoop1?
   935                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   936                      <       	JMP		L_ChecksumLoop1?	
   937                      <       		
   938                      <       L_ExitRomSum1?:		
   939                      <       .IF (GPL815P04Ax+GPL815P04Bx+GPL815P03Ax+GPL815P03Bx)	
   940                      <       ;===================================Bank0H==============================================
   941                      <       	LDA		#.HIGH.D_Bank0HUserRomStartAddr
   942                      <       	STA		R_ChecksumAddrPtr + 1				;Start High Byte
   943                      <       	LDA		#.LOW.D_Bank0HUserRomStartAddr
   944                      <       	STA		R_ChecksumAddrPtr
   945                      <       	
   946                      <       L_ChecksumLoop1H?
   947                      <       	STA	   P_WDT_Clear	
   948                      <       	CLC
   949                      <       	LDA		(R_ChecksumAddrPtr),Y
   950                      <       	ADC		R_ChecksumResult					;Result Low Byte
   951                      <       	STA		R_ChecksumResult					;Result Low Byte
   952                      <       	BCC		L_CheckAddress1H?
   953                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   954                      <       	BNE		L_CheckAddress1H?
   955                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   956                      <       	BNE		L_CheckAddress1H?
   957                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   958                      <       		
   959                      <       L_CheckAddress1H?:
   960                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   961                      <       	CMP		#.HIGH.D_Bank0HUserRomEndAddr		;End High Byte
   962                      <       	BNE		L_IncreaseAdd1H?
   963                      <       	
   964                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   965                      <       	CMP		#.LOW.D_Bank0HUserRomEndAddr			;End Low Byte
   966                      <       	BEQ		L_ExitRomSum1H?
   967                      <       	
   968                      <       L_IncreaseAdd1H?:
   969                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   970                      <       	BNE		L_ChecksumLoop1H?
   971                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   972                      <       	JMP		L_ChecksumLoop1H?	
   973                      <       		
   974                      <       L_ExitRomSum1H?:	
   975                      <       .ENDIF	
   976                      <       ;===================NMI & Reset Vector==================================================		
   977                      <       	LDA		#.HIGH.D_NMIandResetVectorStartAddr
   978                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   979                      <       	LDA		#.LOW.D_NMIandResetVectorStartAddr
   980                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   981                      <       		
   982                      <       L_ChecksumLoop2?
   983                      <       	STA	   P_WDT_Clear		
   984                      <       	CLC
   985                      <       	LDA		(R_ChecksumAddrPtr),Y
   986                      <       	ADC		R_ChecksumResult					;Result Low Byte
   987                      <       	STA		R_ChecksumResult					;Result Low Byte
   988                      <       	BCC		L_CheckAddress2?
   989                      <       	INC		R_ChecksumResult + 1				;Result Byte2
   990                      <       	BNE		L_CheckAddress2?
   991                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   992                      <       	BNE		L_CheckAddress2?
   993                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   994                      <       		
   995                      <       L_CheckAddress2?:
   996                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   997                      <       	CMP		#.HIGH.D_NMIandResetVectorEndAddr	;End High Byte
   998                      <       	BNE		L_IncreaseAdd2?
   999                      <       	
  1000                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
  1001                      <       	CMP		#.LOW.D_NMIandResetVectorEndAddr	;End Low Byte
  1002                      <       	BEQ		L_ExitRomSum2?
  1003                      <       	
  1004                      <       L_IncreaseAdd2?:
  1005                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
  1006                      <       	BNE		L_ChecksumLoop2?
  1007                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
  1008                      <       	JMP		L_ChecksumLoop2?	
  1009                      <       		
  1010                      <       L_ExitRomSum2?:	
  1011                      <       	.ENDM
  1012                      <       
  1013                      <       	.ENDIF
  1014                      <       .endif
  1015                      <       	.ENDIF	
  1016                      <       
  1017                              .INCLUDE    	lcd\lcd.tab
  1018 0000F21F             <       lcdtab:		.section
  1019                      <       ;==============================
  1020                      <       C_Com0MinByteNum:	.EQU	0			;com0
  1021                      <       C_Com1MinByteNum:	.EQU	6			;com1
  1022                      <       C_Com2MinByteNum:	.EQU	12			;com2
  1023                      <       C_Com3MinByteNum:	.EQU	18			;com3
  1024                      <       C_Com4MinByteNum:	.EQU	24			;com4
  1025                      <       C_Com5MinByteNum:	.EQU	30			;com5
  1026                      <       lcd				equ	0   ;1为调试，0为实际的seg
  1027                      <       .IF	lcd
  1028                      <       ;$2000-------------------------------------
  1029                      <       C_Seg00:		.EQU	10000000B			;seg0
  1030                      <       C_Seg01:		.EQU	01000000B			;seg1
  1031                      <       C_Seg02:		.EQU	00100000B			;seg2
  1032                      <       C_Seg03:		.EQU	00010000B			;seg3
  1033                      <       C_Seg04:		.EQU	00001000B			;seg4
  1034                      <       C_Seg05:		.EQU	00000100B			;seg5
  1035                      <       C_Seg06:		.EQU	00000010B			;seg6
  1036                      <       C_Seg07:		.EQU	00000001B			;seg7
