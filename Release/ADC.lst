   712                      <       	D_PWMIO2En:						.EQU	00000100B	
   713                      <       	D_PWMIO3En:						.EQU	00001000B	
   714                      <       	D_PWMClkSysClk:					.EQU	00000000B
   715                      <       	D_PWMClkSysClk8:				.EQU	00010000B	
   716                      <       	D_PWMClkSysClk64:				.EQU	00100000B	
   717                      <       	D_PWMClk32K:					.EQU	00110000B
   718                      <       	D_PWMClkTM0:					.EQU	01000000B
   719                      <       	D_PWMClkTM1:					.EQU	01010000B	
