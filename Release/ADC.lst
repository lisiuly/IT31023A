  1274                              ; 代码段
  1275                              ;==========================================
  1276 0000FC47                     ADC_Code:	.section	
  1277                              
  1278                              ;==========================================================================
  1279                              ; 子程序: F_ADC_Delay4ms
  1280                              ; 描述  : 软件延时约 4ms（基于 2MHz 系统时钟）
  1281                              ;         外8次 × 内200次 × 约5cycle = 8000 cycle ≈ 4ms
  1282                              ; 破坏  : R_ADC_DelayOuter, R_ADC_DelayInner
  1283                              ;==========================================================================
  1284 0000FC47                     F_ADC_Delay4ms:
  1285 0000FC47 A9 08               		LDA		#08H
  1286 0000FC49 85 93               		STA		R_ADC_DelayOuter
  1287 0000FC4B                     ?L_DelayOuter:
  1288 0000FC4B A9 C8               		LDA		#0C8H			; 200次内层
  1289 0000FC4D 85 94               		STA		R_ADC_DelayInner
  1290 0000FC4F                     ?L_DelayInner:
  1291 0000FC4F C6 94               		DEC		R_ADC_DelayInner
  1292 0000FC51 D0 FC               		BNE		?L_DelayInner
  1293 0000FC53 C6 93               		DEC		R_ADC_DelayOuter
  1294 0000FC55 D0 F4               		BNE		?L_DelayOuter
  1295 0000FC57 60                  		RTS
  1296                              
  1297                              ;==========================================================================
  1298                              ; 函数: ADC_Init / _ADC_Init
  1299                              ; 描述: 初始化 ADC 参考电压为 3.2V 并使能内部稳压器
  1300                              ; 调用: 系统上电后，主循环前调用一次
  1301                              ;==========================================================================
  1302 0000FC58                     ADC_Init:
  1303 0000FC58                     _ADC_Init:
  1304 0000FC58 A9 0B               		LDA		#D_ADCVregEn + D_ADCVreg3P2V
  1305 0000FC5A 8D 44 33            		STA		P_ADC_VREF_Ctrl
  1306 0000FC5D                     L_DCDet_Exit:
  1307 0000FC5D 60                  		RTS		
  1308                              	
  1309                              
  1310                              ;==========================================================================
  1311                              ; 函数: F_DC_Det / _F_DC_Det
  1312                              ; 描述: 电池电压检测主函数
  1313                              ;       1. 采集 VSS（零偏校准）
  1314                              ;       2. 采集 PB7（经 2:1 分压的电池电压）
  1315                              ;       3. 公式换算后判断 3.8V / 3.6V / 3.4V 档位
  1316                              ;       4. 更新 R_LVDStatus, R_Charge, R_KeyFlag
  1317                              ; 调用: 主循环或定时器中周期性调用
  1318                              ;==========================================================================
  1319 0000FC5E                     F_DC_Det:
  1320 0000FC5E                     _F_DC_Det:
  1321                              		;--- Guard: 关机态不检测 ---
  1322 0000FC5E AD 71 00            		LDA		R_KeyFlag
  1323 0000FC61 29 02               		AND		#D_LCDOFF
  1324 0000FC63 D0 F8               		BNE		L_DCDet_Exit
  1325                              
  1326                              		;--- Guard: 充电中不检测 ---
  1327 0000FC65 AD 85 00            		LDA		R_Charge
  1328 0000FC68 29 02               		AND		#D_Charge
  1329 0000FC6A D0 F1               		BNE		L_DCDet_Exit
  1330                              
  1331                              		;==================================================
  1332                              		; 步骤1: 设置 VREF + VSS 预热转换 + Delay 4ms
  1333                              		;==================================================
  1334 0000FC6C A9 0B               		LDA		#D_ADCVregEn + D_ADCVreg3P2V
  1335 0000FC6E 8D 44 33            		STA		P_ADC_VREF_Ctrl
  1336                              
  1337 0000FC71 A9 9B               		LDA		#D_ADCVSS + D_ADCEn + D_ADCStatus
  1338 0000FC73 8D 41 33            		STA		P_ADC_Ctrl2
  1339                              
  1340 0000FC76 A9 9A               		LDA		#D_ADCClkDiv8 + D_ADCSHCycle16 + D_ADCTrigManual + D_ADCStart
  1341 0000FC78 8D 40 33            		STA		P_ADC_Ctrl1
  1342                              
  1343 0000FC7B 20 47 FC            		JSR		F_ADC_Delay4ms
  1344                              
  1345                              		;==================================================
  1346                              		; 步骤2: 正式采样 VSS，存储数据
  1347                              		;==================================================
  1348 0000FC7E A9 80               		LDA		#80H
  1349 0000FC80 8D E1 30            		STA		P_INT_ADC_Clear
  1350                              
  1351 0000FC83 A9 9B               		LDA		#D_ADCVSS + D_ADCEn + D_ADCStatus
  1352 0000FC85 8D 41 33            		STA		P_ADC_Ctrl2
  1353                              
  1354 0000FC88 A9 9A               		LDA		#D_ADCClkDiv8 + D_ADCSHCycle16 + D_ADCTrigManual + D_ADCStart
  1355 0000FC8A 8D 40 33            		STA		P_ADC_Ctrl1
  1356                              
  1357 0000FC8D                     ?L_ADC_VSSNorReady:
  1358 0000FC8D 8D 0B 30            		STA		P_WDT_Clear
  1359 0000FC90 AD 41 33            		LDA		P_ADC_Ctrl2
  1360 0000FC93 29 80               		AND		#D_ADCStatus
  1361 0000FC95 F0 F6               		BEQ		?L_ADC_VSSNorReady
  1362 0000FC97                     ?L_ADC_VSSNorEnd:
  1363 0000FC97 A9 00               		LDA		#00H
  1364 0000FC99 8D 40 33            		STA		P_ADC_Ctrl1
  1365 0000FC9C A9 80               		LDA		#D_ADCStatus
  1366 0000FC9E 8D 41 33            		STA		P_ADC_Ctrl2
  1367                              
  1368 0000FCA1 A9 02               		LDA		#D_ADC_Flag
  1369 0000FCA3 8D CC 30            		STA		P_INT_Status3		; 清除 ADC 中断标志
  1370                              
  1371 0000FCA6 AD 42 33            		LDA		P_ADC_Data_LB
  1372 0000FCA9 85 8D               		STA		R_ADC_VSS_MB
  1373 0000FCAB AD 43 33            		LDA		P_ADC_Data_HB
  1374 0000FCAE 85 8E               		STA		R_ADC_VSS_HB		; 保存 VSS 原始数据
  1375                              
  1376                              		;==================================================
  1377                              		; 步骤3: 切换 PB7 为 LineIn + Delay 4ms
  1378                              		;==================================================
  1379 0000FCB0 A9 80               		LDA		#80H				; PB7 为 Line-in（ADC 输入）
  1380 0000FCB2 8D 86 30            		STA		P_IO_PB_LINEN_Ctrl
  1381                              
  1382 0000FCB5 A9 80               		LDA		#D_ADCStatus
  1383 0000FCB7 8D 41 33            		STA		P_ADC_Ctrl2
  1384 0000FCBA A9 17               		LDA		#D_ADCPB7 + D_ADCEn
  1385 0000FCBC 8D 41 33            		STA		P_ADC_Ctrl2
  1386                              
  1387 0000FCBF 20 47 FC            		JSR		F_ADC_Delay4ms
  1388                              
  1389                              		;==================================================
  1390                              		; 步骤4: 正式采样 PB7，存储数据
  1391                              		;==================================================
  1392 0000FCC2 A9 17               		LDA		#D_ADCPB7 + D_ADCEn
  1393 0000FCC4 8D 41 33            		STA		P_ADC_Ctrl2
  1394                              
  1395 0000FCC7 A9 99               		LDA		#D_ADCClkDiv4 + D_ADCSHCycle16 + D_ADCTrigManual + D_ADCStart
  1396 0000FCC9 8D 40 33            		STA		P_ADC_Ctrl1
  1397                              
  1398 0000FCCC                     ?L_ADC_VSSNorReadypb:
  1399 0000FCCC 8D 0B 30            		STA		P_WDT_Clear
  1400 0000FCCF AD 41 33            		LDA		P_ADC_Ctrl2
  1401 0000FCD2 29 80               		AND		#D_ADCStatus
  1402 0000FCD4 F0 F6               		BEQ		?L_ADC_VSSNorReadypb
  1403                              
  1404 0000FCD6 A9 00               		LDA		#00H
  1405 0000FCD8 8D 40 33            		STA		P_ADC_Ctrl1
  1406 0000FCDB A9 80               		LDA		#D_ADCStatus
  1407 0000FCDD 8D 41 33            		STA		P_ADC_Ctrl2
  1408                              
  1409 0000FCE0 A9 02               		LDA		#D_ADC_Flag
  1410 0000FCE2 8D CC 30            		STA		P_INT_Status3		; 清除 ADC 中断标志
  1411                              
  1412 0000FCE5 AD 42 33            		LDA		P_ADC_Data_LB
  1413 0000FCE8 85 8F               		STA		R_ADC_LineIn_MB
  1414 0000FCEA AD 43 33            		LDA		P_ADC_Data_HB
  1415 0000FCED 85 90               		STA		R_ADC_LineIn_HB		; 保存 PB7 原始数据
  1416                              
  1417                              		;==================================================
  1418                              		; 步骤5: 数据为 bit15~bit4，统一右移 4bit
  1419                              		;==================================================
  1420 0000FCEF 46 8E               		LSR		R_ADC_VSS_HB
  1421 0000FCF1 66 8D               		ROR		R_ADC_VSS_MB
  1422 0000FCF3 46 8E               		LSR		R_ADC_VSS_HB
  1423 0000FCF5 66 8D               		ROR		R_ADC_VSS_MB
  1424 0000FCF7 46 8E               		LSR		R_ADC_VSS_HB
  1425 0000FCF9 66 8D               		ROR		R_ADC_VSS_MB
  1426 0000FCFB 46 8E               		LSR		R_ADC_VSS_HB
  1427 0000FCFD 66 8D               		ROR		R_ADC_VSS_MB
  1428                              
  1429 0000FCFF 46 90               		LSR		R_ADC_LineIn_HB
  1430 0000FD01 66 8F               		ROR		R_ADC_LineIn_MB
  1431 0000FD03 46 90               		LSR		R_ADC_LineIn_HB
  1432 0000FD05 66 8F               		ROR		R_ADC_LineIn_MB
  1433 0000FD07 46 90               		LSR		R_ADC_LineIn_HB
  1434 0000FD09 66 8F               		ROR		R_ADC_LineIn_MB
  1435 0000FD0B 46 90               		LSR		R_ADC_LineIn_HB
  1436 0000FD0D 66 8F               		ROR		R_ADC_LineIn_MB
  1437                              
  1438                              		;==================================================
  1439                              		; 步骤6: 按公式计算
  1440                              		;   R_ADC_VREF  = 0x0FFF - R_ADC_VSS   (分母)
  1441                              		;   R_ADC_LineIn = R_ADC_LineIn - R_ADC_VSS  (分子，零偏校正)
  1442                              		; 注: 此处只做减法，档位判断直接对校正后 LineIn 做阈值比较
  1443                              		;     (相当于在同一 VREF 坐标系下比较，无需完整乘除)
  1444                              		;==================================================
  1445 0000FD0F 38                  		SEC
  1446 0000FD10 A9 FF               		LDA		#0FFH
  1447 0000FD12 E5 8D               		SBC		R_ADC_VSS_MB
  1448 0000FD14 85 91               		STA		R_ADC_VREF_MB
  1449 0000FD16 A9 0F               		LDA		#0FH
  1450 0000FD18 E5 8E               		SBC		R_ADC_VSS_HB
  1451 0000FD1A 85 92               		STA		R_ADC_VREF_HB
  1452                              
  1453 0000FD1C 38                  		SEC
  1454 0000FD1D A5 8F               		LDA		R_ADC_LineIn_MB
  1455 0000FD1F E5 8D               		SBC		R_ADC_VSS_MB
  1456 0000FD21 85 8F               		STA		R_ADC_LineIn_MB
  1457 0000FD23 A5 90               		LDA		R_ADC_LineIn_HB
  1458 0000FD25 E5 8E               		SBC		R_ADC_VSS_HB
  1459 0000FD27 85 90               		STA		R_ADC_LineIn_HB
  1460                              
  1461                              		;==================================================
  1462                              		; 步骤7: 16位档位判断（先比高字节，再比低字节）
  1463                              		; 阈值基于: VREF=3.2V, 2:1分压
  1464                              		;   3.8V -> 0x097F, 3.6V -> 0x08FF, 3.4V -> 0x087F
  1465                              		;==================================================
  1466                              
  1467                              		;--- 判断是否 >= 3.8V ---
  1468 0000FD29 A5 90               		LDA		R_ADC_LineIn_HB
  1469 0000FD2B C9 09               		CMP		#C_ADC_Bat38V_HB
  1470 0000FD2D 90 20               		BCC		?L_Check36V			; HB < 阈值，检查下一档
  1471 0000FD2F D0 06               		BNE		?L_Bat_Level1		; HB > 阈值，确定 Level1
  1472 0000FD31 A5 8F               		LDA		R_ADC_LineIn_MB		; HB 相等，比较 MB
  1473 0000FD33 C9 9F               		CMP		#C_ADC_Bat38V_MB
  1474 0000FD35 90 18               		BCC		?L_Check36V
  1475 0000FD37                     ?L_Bat_Level1:
  1476 0000FD37 A9 01               		LDA		#D_BatLevel1
  1477 0000FD39 8D 86 00            		STA		R_LVDStatus
  1478                              		%bitr	R_Charge, D_LowPower
  1479 0000FD3C AD 85 00          1           lda     R_Charge               ;ex.  
  1480 0000FD3F 29 FE             1           and     #.NOT.D_LowPower         ;  %bitr 10H,_BIT0;  10H.0=0
  1481 0000FD41 8D 85 00          1           sta     R_Charge
  1482                              		%bits	R_KeyFlag, D_UpdateBAT
  1483 0000FD44 AD 71 00          1           lda     R_KeyFlag               ;ex.  
  1484 0000FD47 09 10             1           ora     #D_UpdateBAT              ;  %bits 10H,_BIT0
  1485                            1 		                   ;  10H.0=1
  1486 0000FD49 8D 71 00          1           sta     R_KeyFlag               ;
  1487 0000FD4C 4C B0 FD            		JMP		?L_DCDet_Exit
  1488                              
  1489                              		;--- 判断是否 >= 3.6V ---
  1490 0000FD4F                     ?L_Check36V:
  1491 0000FD4F A5 90               		LDA		R_ADC_LineIn_HB
  1492 0000FD51 C9 09               		CMP		#C_ADC_Bat36V_HB
  1493 0000FD53 90 20               		BCC		?L_Check34V
  1494 0000FD55 D0 06               		BNE		?L_Bat_Level2
  1495 0000FD57 A5 8F               		LDA		R_ADC_LineIn_MB
  1496 0000FD59 C9 1F               		CMP		#C_ADC_Bat36V_MB
  1497 0000FD5B 90 18               		BCC		?L_Check34V
  1498 0000FD5D                     ?L_Bat_Level2:
  1499 0000FD5D A9 02               		LDA		#D_BatLevel2
  1500 0000FD5F 8D 86 00            		STA		R_LVDStatus
  1501                              		%bitr	R_Charge, D_LowPower
  1502 0000FD62 AD 85 00          1           lda     R_Charge               ;ex.  
  1503 0000FD65 29 FE             1           and     #.NOT.D_LowPower         ;  %bitr 10H,_BIT0;  10H.0=0
  1504 0000FD67 8D 85 00          1           sta     R_Charge
  1505                              		%bits	R_KeyFlag, D_UpdateBAT
  1506 0000FD6A AD 71 00          1           lda     R_KeyFlag               ;ex.  
  1507 0000FD6D 09 10             1           ora     #D_UpdateBAT              ;  %bits 10H,_BIT0
  1508                            1 		                   ;  10H.0=1
  1509 0000FD6F 8D 71 00          1           sta     R_KeyFlag               ;
  1510 0000FD72 4C B0 FD            		JMP		?L_DCDet_Exit
  1511                              
  1512                              		;--- 判断是否 >= 3.4V ---
  1513 0000FD75                     ?L_Check34V:
  1514 0000FD75 A5 90               		LDA		R_ADC_LineIn_HB
  1515 0000FD77 C9 08               		CMP		#C_ADC_Bat34V_HB
  1516 0000FD79 90 20               		BCC		?L_Bat_LowPower
  1517 0000FD7B D0 06               		BNE		?L_Bat_Level3
  1518 0000FD7D A5 8F               		LDA		R_ADC_LineIn_MB
  1519 0000FD7F C9 9F               		CMP		#C_ADC_Bat34V_MB
  1520 0000FD81 90 18               		BCC		?L_Bat_LowPower
  1521 0000FD83                     ?L_Bat_Level3:
  1522 0000FD83 A9 04               		LDA		#D_BatLevel3
  1523 0000FD85 8D 86 00            		STA		R_LVDStatus
  1524                              		%bitr	R_Charge, D_LowPower
  1525 0000FD88 AD 85 00          1           lda     R_Charge               ;ex.  
  1526 0000FD8B 29 FE             1           and     #.NOT.D_LowPower         ;  %bitr 10H,_BIT0;  10H.0=0
  1527 0000FD8D 8D 85 00          1           sta     R_Charge
  1528                              		%bits	R_KeyFlag, D_UpdateBAT
  1529 0000FD90 AD 71 00          1           lda     R_KeyFlag               ;ex.  
  1530 0000FD93 09 10             1           ora     #D_UpdateBAT              ;  %bits 10H,_BIT0
  1531                            1 		                   ;  10H.0=1
  1532 0000FD95 8D 71 00          1           sta     R_KeyFlag               ;
  1533 0000FD98 4C B0 FD            		JMP		?L_DCDet_Exit
  1534                              
  1535                              		;--- 低于 3.4V，低电标志 ---
  1536 0000FD9B                     ?L_Bat_LowPower:
  1537 0000FD9B A9 00               		LDA		#00H
  1538 0000FD9D 8D 86 00            		STA		R_LVDStatus
  1539                              		%bits	R_Charge, D_LowPower
  1540 0000FDA0 AD 85 00          1           lda     R_Charge               ;ex.  
  1541 0000FDA3 09 01             1           ora     #D_LowPower              ;  %bits 10H,_BIT0
  1542                            1 		                   ;  10H.0=1
  1543 0000FDA5 8D 85 00          1           sta     R_Charge               ;
  1544                              		%bits	R_KeyFlag, D_UpdateBAT
  1545 0000FDA8 AD 71 00          1           lda     R_KeyFlag               ;ex.  
  1546 0000FDAB 09 10             1           ora     #D_UpdateBAT              ;  %bits 10H,_BIT0
  1547                            1 		                   ;  10H.0=1
  1548 0000FDAD 8D 71 00          1           sta     R_KeyFlag               ;
  1549                              
  1550 0000FDB0                     ?L_DCDet_Exit:
  1551 0000FDB0 60                  		RTS
  1552                              
  1553                              .ENDS
  1554                              .END
