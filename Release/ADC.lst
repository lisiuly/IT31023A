   784                      <       ;**********************************************************************
   785                      <       ;ROM Checksum
   786                      <       ;**********************************************************************
   787                      <       .IF (GPL815P04Ax)
   788                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5, 0x8000 ~ 0xBFFF
   789                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   790                      <       ;				   
   791                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   792                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   793                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0xBFFF:User ROM Code
   794                      <       	D_Bank0HUserRomEndAddr:			.EQU	0xBFFF	
   795                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   796                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   797                      <       .ENDIF
   798                      <       
   799                      <       .IF (GPL815P04Ax_16KB)
   800                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5
   801                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   802                      <       ;				   
   803                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   804                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   805                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   806                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   807                      <       .ENDIF	
   808                      <       
   809                      <       .IF (GPL815P04Bx)
   810                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5, 0x8000 ~ 0xBFFF (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   811                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   812                      <       ;				   
   813                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   814                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   815                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0xBFFF:User ROM Code
   816                      <       	D_Bank0HUserRomEndAddr:			.EQU	0xBFFF	
   817                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   818                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   819                      <       .ENDIF	
   820                      <       
   821                      <       .IF (GPL815P04Bx_15KB)
   822                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5 (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   823                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   824                      <       ;				   
   825                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   826                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   827                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   828                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   829                      <       .ENDIF
   830                      <       
   831                      <       .IF (GPL815P03Ax)
   832                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5, 0x8000 ~ 0x9FFF
   833                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   834                      <       ;				   
   835                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   836                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   837                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0x9FFF:User ROM Code
   838                      <       	D_Bank0HUserRomEndAddr:			.EQU	0x9FFF	
   839                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   840                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD
   841                      <       .ENDIF
   842                      <       
   843                      <       .IF (GPL815P03Bx)
   844                      <       ;	ROM Checksum : Bank0 address :		  0x4400 ~ 0x7FE5, 0x8000 ~ 0x9FFF (0x4000 ~ 0x43FF for GP Test Code : 1K Bytes)
   845                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   846                      <       ;				   
   847                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4400		;0x4400 ~ 0x7FE5:User ROM Code
   848                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   849                      <       	D_Bank0HUserRomStartAddr:		.EQU	0x8000		;0x8000 ~ 0x9FFF:User ROM Code
   850                      <       	D_Bank0HUserRomEndAddr:			.EQU	0x9FFF	
   851                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   852                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD
   853                      <       .ENDIF	
   854                      <       
   855                      <       .IF (GPL815P02Ax)
   856                      <       ;	ROM Checksum : Bank0 address :		  0x4000 ~ 0x7FE5
   857                      <       ;				   NMI and Reset Vector : 0xFFFA ~ 0xFFFD
   858                      <       ;				   
   859                      <       	D_Bank0UserRomStartAddr:		.EQU	0x4000		;0x4000 ~ 0x7FE5:User ROM Code
   860                      <       	D_Bank0UserRomEndAddr:			.EQU	0x7FE5
   861                      <       	D_NMIandResetVectorStartAddr:	.EQU	0x7FFA
   862                      <       	D_NMIandResetVectorEndAddr:		.EQU	0x7FFD	
   863                      <       .ENDIF	
   864                      <       ; ========================================================================================
   865                      <       ; Macro Name	: M_UserRomChecksum
   866                      <       ; Parameters	: None
   867                      <       ; Return Value	: R_ChecksumResult: bit[7:0]
   868                      <       ;				: R_ChecksumResult + 1: bit[15:8]
   869                      <       ;				: R_ChecksumResult + 2: bit[23:16]
   870                      <       ;				: R_ChecksumResult + 3: bit[31:24]
   871                      <       ; Description	: Calculate user ROM area code checksum
   872                      <       ; Destroy		: A, X
   873                      <       ; Example		: %M_UserRomChecksum	R_ChecksumAddrPtr, R_ChecksumResult
   874                      <       ; ========================================================================================	
   875                      <       %M_UserRomChecksum:	.MACRO	R_ChecksumAddrPtr, R_ChecksumResult
   876                      <       	LDA		#0
   877                      <       	STA		R_ChecksumResult					;Result Byte0
   878                      <       	STA		R_ChecksumResult + 1				;Result Byte1
   879                      <       	STA		R_ChecksumResult + 2				;Result Byte2
   880                      <       	STA		R_ChecksumResult + 3				;Result Byte3
   881                      <       ;=================== Bank 0 ==================================================	
   882                      <       	LDA		#.HIGH.D_Bank0UserRomStartAddr
   883                      <       	STA		R_ChecksumAddrPtr + 1				;Start High Byte
   884                      <       	LDA		#.LOW.D_Bank0UserRomStartAddr
   885                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   886                      <       		
   887                      <       	LDY		#0	
   888                      <       
   889                      <       L_ChecksumLoop1?
   890                      <       	STA	   P_WDT_Clear	
   891                      <       	CLC
   892                      <       	LDA		(R_ChecksumAddrPtr),Y
   893                      <       	ADC		R_ChecksumResult					;Result Low Byte
   894                      <       	STA		R_ChecksumResult					;Result Low Byte
   895                      <       	BCC		L_CheckAddress1?
   896                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   897                      <       	BNE		L_CheckAddress1?
   898                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   899                      <       	BNE		L_CheckAddress1?
   900                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   901                      <       		
   902                      <       L_CheckAddress1?:
   903                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   904                      <       	CMP		#.HIGH.D_Bank0UserRomEndAddr		;End High Byte
   905                      <       	BNE		L_IncreaseAdd1?
   906                      <       	
   907                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   908                      <       	CMP		#.LOW.D_Bank0UserRomEndAddr			;End Low Byte
   909                      <       	BEQ		L_ExitRomSum1?
   910                      <       	
   911                      <       L_IncreaseAdd1?:
   912                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   913                      <       	BNE		L_ChecksumLoop1?
   914                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   915                      <       	JMP		L_ChecksumLoop1?	
   916                      <       		
   917                      <       L_ExitRomSum1?:		
   918                      <       .IF (GPL815P04Ax+GPL815P04Bx+GPL815P03Ax+GPL815P03Bx)	
   919                      <       ;===================================Bank0H==============================================
   920                      <       	LDA		#.HIGH.D_Bank0HUserRomStartAddr
   921                      <       	STA		R_ChecksumAddrPtr + 1				;Start High Byte
   922                      <       	LDA		#.LOW.D_Bank0HUserRomStartAddr
   923                      <       	STA		R_ChecksumAddrPtr
   924                      <       	
   925                      <       L_ChecksumLoop1H?
   926                      <       	STA	   P_WDT_Clear	
   927                      <       	CLC
   928                      <       	LDA		(R_ChecksumAddrPtr),Y
   929                      <       	ADC		R_ChecksumResult					;Result Low Byte
   930                      <       	STA		R_ChecksumResult					;Result Low Byte
   931                      <       	BCC		L_CheckAddress1H?
   932                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   933                      <       	BNE		L_CheckAddress1H?
   934                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   935                      <       	BNE		L_CheckAddress1H?
   936                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   937                      <       		
   938                      <       L_CheckAddress1H?:
   939                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   940                      <       	CMP		#.HIGH.D_Bank0HUserRomEndAddr		;End High Byte
   941                      <       	BNE		L_IncreaseAdd1H?
   942                      <       	
   943                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   944                      <       	CMP		#.LOW.D_Bank0HUserRomEndAddr			;End Low Byte
   945                      <       	BEQ		L_ExitRomSum1H?
   946                      <       	
   947                      <       L_IncreaseAdd1H?:
   948                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   949                      <       	BNE		L_ChecksumLoop1H?
   950                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   951                      <       	JMP		L_ChecksumLoop1H?	
   952                      <       		
   953                      <       L_ExitRomSum1H?:	
   954                      <       .ENDIF	
   955                      <       ;===================NMI & Reset Vector==================================================		
   956                      <       	LDA		#.HIGH.D_NMIandResetVectorStartAddr
   957                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   958                      <       	LDA		#.LOW.D_NMIandResetVectorStartAddr
   959                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   960                      <       		
   961                      <       L_ChecksumLoop2?
   962                      <       	STA	   P_WDT_Clear		
   963                      <       	CLC
   964                      <       	LDA		(R_ChecksumAddrPtr),Y
   965                      <       	ADC		R_ChecksumResult					;Result Low Byte
   966                      <       	STA		R_ChecksumResult					;Result Low Byte
   967                      <       	BCC		L_CheckAddress2?
   968                      <       	INC		R_ChecksumResult + 1				;Result Byte2
   969                      <       	BNE		L_CheckAddress2?
   970                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   971                      <       	BNE		L_CheckAddress2?
   972                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   973                      <       		
   974                      <       L_CheckAddress2?:
   975                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   976                      <       	CMP		#.HIGH.D_NMIandResetVectorEndAddr	;End High Byte
   977                      <       	BNE		L_IncreaseAdd2?
   978                      <       	
   979                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   980                      <       	CMP		#.LOW.D_NMIandResetVectorEndAddr	;End Low Byte
   981                      <       	BEQ		L_ExitRomSum2?
   982                      <       	
   983                      <       L_IncreaseAdd2?:
   984                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   985                      <       	BNE		L_ChecksumLoop2?
   986                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   987                      <       	JMP		L_ChecksumLoop2?	
   988                      <       		
   989                      <       L_ExitRomSum2?:	
   990                      <       	.ENDM
   991                      <       
   992                      <       	.ENDIF
   993                      <       .endif
   994                      <       	.ENDIF	
