  1218                              ;==========================================
  1219                              ; 常量定义
  1220                              ;==========================================
  1221                              ;--- 档位阈值（已减去 VSS 偏移后的 12-bit 值，VREF=3.2V，2:1 分压）---
  1222                              ; 3.8V -> PIN=1.9V -> (1900*4095/3200) = 2431 = 0x09_7F
  1223                              ; 3.6V -> PIN=1.8V -> (1800*4095/3200) = 2303 = 0x08_FF
  1224                              ; 3.4V -> PIN=1.7V -> (1700*4095/3200) = 2175 = 0x08_7F	;整体调高20H
  1225                              C_ADC_Bat38V_HB		.EQU	09H		; >=3.8V 高字节
  1226                              C_ADC_Bat38V_MB		.EQU	9FH;	7FH		; >=3.8V 低字节
  1227                              C_ADC_Bat36V_HB		.EQU	09H	;	08H		; >=3.6V 高字节
  1228                              C_ADC_Bat36V_MB		.EQU	1FH;	0FFH	; >=3.6V 低字节
  1229                              C_ADC_Bat34V_HB		.EQU	08H		; >=3.4V 高字节
  1230                              C_ADC_Bat34V_MB		.EQU	9FH;	7FH		; >=3.4V 低字节
  1231                              
