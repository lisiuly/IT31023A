  1184                      <       ;----------------------------------------------------------
  1185                      <       ;/***********************************************/
  1186                      <       ;         i.L=1 
  1187                      <       %bits:   .MACRO   i,L             ;BYTE i;  
  1188                      <                 lda     i               ;ex.  
  1189                      <                 ora     #L              ;  %bits 10H,_BIT0
  1190                      <       		                   ;  10H.0=1
  1191                      <                 sta     i               ;
  1192                      <                .ENDM    
  1193                      <       
  1194                      <       ;/***********************************************/
  1195                      <       ;         i.L=0
  1196                      <       %bitr:   .MACRO   i,L             ;BYTE i;  
  1197                      <                 lda     i               ;ex.  
  1198                      <                 and     #.NOT.L         ;  %bitr 10H,_BIT0;  10H.0=0
  1199                      <                 sta     i
  1200                      <                .ENDM    
  1201                      <       
  1202                      <       ;/***********************************************/
  1203                      <       ;         if(i.L==1) goto N
  1204                      <       %btst:   .MACRO   i,L,N           ;BYTE i;  
  1205                      <                 lda     i               ;ex.   
  1206                      <                 and     #L              ;  %btst 10H,_BIT0,N
  1207                      <                 bne     N               ;  if(10H.0=1) goto N 
  1208                      <                .ENDM    
  1209                      <                                         
  1210                      <       ;/***********************************************/
  1211                      <       ;         if(i.L==0) goto N
  1212                      <       %btsf:   .MACRO   i,L,N           ;BYTE i;    
  1213                      <                 lda     i               ;ex.   
  1214                      <                 and     #L              ;  %btsf 10H,_BIT0,N
  1215                      <                 beq     N               ;  if(10H.0=0) goto N 
  1216                      <                .ENDM    
