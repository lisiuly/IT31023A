   746                      <       	D_RFCTM0ClkStop:				.EQU	00000000B
   747                      <       	D_RFCTM0ClkIO:					.EQU	00000100B
   748                      <       	D_RFCTM0ClkSysClk:				.EQU	00001100B
   749                      <       	D_RFCTM0ClkSysClk2:				.EQU	00010000B
   750                      <       	D_RFCTM0ClkRFC1:				.EQU	00010100B
   751                      <       	D_RFCTM0ClkRFC2:				.EQU	00011000B
