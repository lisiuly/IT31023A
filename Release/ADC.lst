  1254                              ; 变量声明（PAGE0）
  1255                              ;==========================================
  1256 0000008D                     ADC_RAM:	.section	.PAGE0
  1257 0000008D FF                  R_ADC_VSS_MB:		.DS		1		; VSS 低 8bit（右移4位后）
  1258                              _R_ADC_VSS_MB:		.EQU	R_ADC_VSS_MB
  1259 0000008E FF                  R_ADC_VSS_HB:		.DS		1		; VSS 高 4bit（右移4位后）
  1260                              _R_ADC_VSS_HB:		.EQU	R_ADC_VSS_HB
  1261 0000008F FF                  R_ADC_LineIn_MB:	.DS		1		; PB7 低 8bit（右移4位后）
  1262                              _R_ADC_LineIn_MB:	.EQU	R_ADC_LineIn_MB
  1263 00000090 FF                  R_ADC_LineIn_HB:	.DS		1		; PB7 高 4bit（右移4位后）
  1264                              _R_ADC_LineIn_HB:	.EQU	R_ADC_LineIn_HB
  1265 00000091 FF                  R_ADC_VREF_MB:		.DS		1		; (0xFFF - VSS) 低 8bit
  1266                              _R_ADC_VREF_MB:		.EQU	R_ADC_VREF_MB
  1267 00000092 FF                  R_ADC_VREF_HB:		.DS		1		; (0xFFF - VSS) 高 4bit
  1268                              _R_ADC_VREF_HB:		.EQU	R_ADC_VREF_HB
  1269 00000093 FF                  R_ADC_DelayOuter:	.DS		1		; 延时外层计数
  1270 00000094 FF                  R_ADC_DelayInner:	.DS		1		; 延时内层计数
  1271                              
  1272                              .ENDS
