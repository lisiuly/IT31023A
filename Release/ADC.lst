  1021                      <       .EXTERN		R_SleepTime
  1022                      <       .EXTERN		_R_SleepTime
  1023                      <       .EXTERN		R_SnoozeTime
  1024                      <       .EXTERN		_R_SnoozeTime
  1025                      <       C_SnoozeTime1min	EQU		60
  1026                      <       ;C_SnoozeTime5min	equ		5
  1027                      <       .EXTERN		R_OtherFlag
  1028                      <       ;D_12Mode			equ		0x01	;0默认为24H，1为12H	
  1029                      <       D_Urat_Open			equ		0x02
  1030                      <       D_EnableSnooze		equ		0x04
