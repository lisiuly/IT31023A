  1245                              .PUBLIC		_R_ADC_LineIn_MB
  1246                              .PUBLIC		R_ADC_LineIn_HB
  1247                              .PUBLIC		_R_ADC_LineIn_HB
  1248                              .PUBLIC		R_ADC_VREF_MB
  1249                              .PUBLIC		_R_ADC_VREF_MB
