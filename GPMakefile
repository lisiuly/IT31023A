.PHONY : Overlapper
Overlapper:
	$(OVERLAPPER) $(OLPOPTIONS) -p "IT31023A.cglst" -o $(OVERLAPLIKFILE) -s $(OLPFILE) -oasm "$(IMDIR)\_GPCBankOptimization.asm"
	type $(USERLIKFILE) > $(COMBINELIKFILE) 
	echo. >> $(COMBINELIKFILE) 	
	type $(OVERLAPLIKFILE) >> $(COMBINELIKFILE) 
	$(ECHO)	
	$(ASM) $(ASMFLAG) -o "$(IMDIR)\_GPCBankOptimization.obj" "$(IMDIR)\_GPCBankOptimization.asm"
	$(ECHO)	

ifdef OVERWRITELIK
	$(LINKSCRIPTGEN) -I ".\LinkerScriptParam"
	$(ECHO)
endif

.PHONY : alik
alik: $(ASMOBJFILES) $(USERLIKFILE)
ifdef BANKMODE
	$(ALINK) -b $(CHIPINFO) -p "IT31023A.alst" -o "$(IMDIR)" -l $(USERLIKFILE)
	$(ECHO)
endif

.SUFFIXES : .c .i .asm .obj

.PHONY : build	
build: 	build_init all
	
.PHONY : rebuild	
rebuild: clean rebuild_init all	

.PHONY : all
all : preBuild outputdir resconvert tablegen compile asmirpcheck preLink linker postLink maskoptions reporter postBuild

.PHONY : clean
clean :
	-if not exist "${IMDIR}\$(NULL)" ${MAKEDIR} "${IMDIR}"
	-if not exist "${OUTPUTDIR}\$(NULL)" ${MAKEDIR} "${OUTPUTDIR}"
	$(RM)  $(BINFILE)
	$(RM)  $(OUTPUTFILES)
	$(ECHO)

.PHONY : build_init	
build_init:	$(USERLIKFILE)
	$(INITIALTOOL) -R $(RESDB) -P $(PROGDB) -F $(INITIALTOOCFG) -B $(CHIPINFO) -T Asm -A Reflash
	
.PHONY : rebuild_init	
rebuild_init: $(USERLIKFILE)
	$(INITIALTOOL) -R $(RESDB) -P $(PROGDB) -F $(INITIALTOOCFG) -B $(CHIPINFO) -T Asm -A Create
	
.PHONY : outputdir	
outputdir:
	if not exist "$(OUTPUTDIR)\$(NULL)" mkdir "$(OUTPUTDIR)"
	if not exist "$(IMDIR)\$(NULL)" mkdir "$(IMDIR)"
	$(ECHO)
	
.PHONY : resconvert
resconvert : 
	$(RESERVEDAREA) -D $(RESDB) -R $(RESERVEDAREACFG)
	$(ECHO)
	$(RESCONV) -R $(RESDB) -P $(PROGDB) $(CCONF)  -O "$(PROJECTDIR)\\$(IMDIR)" -B $(BODYSERIES) $(ASM_INC_PATH) -CP "$(PROJECTDIR)\resource.cfp" -H Yes
	$(ECHO)
	
.PHONY : tablegen	
tablegen :
	$(PROGDATAGEN) -T GP_C -R $(RESDB) -S CODE -O "$(IMDIR)"
	$(ECHO)
	$(ALLOCATOR) -R $(RESDB) -C $(CHIPINFO)
	$(ECHO)

.PHONY : compile
compile : Preprocessor alik compileobj Overlapper rmbinfile

.PHONY : Preprocessor	
Preprocessor: $(CIMFILES) 
	
.PHONY : compileobj
compileobj: $(OBJFILES)

.PHONY : asmirpcheck
asmirpcheck :
	$(ASMIRPCHECK) $(ASMIRPCHECKFLG)
	
.PHONY : rmbinfile
rmbinfile : 
	$(RM) $(BINFILE)
	$(ECHO)
	
.PHONY : linker			
linker :
	$(LINK) ".\_Prog_.lik"
	$(ECHO)
	
.PHONY : maskoptions	
maskoptions:	
	$(MASKOPTION) -i $(BINFILE) -o $(BINFILE) -ePDFrpt "$(CMSFILE)" -bf $(CHIPINFO) -m $(MASKOPTIONCFG) -bi $(BININFOFILE)
	$(ECHO)
	$(PDFCMSHEET) -T "$(PDFCONFIRMSHEETTEMPLATE)" -P "$(CMSFILE)" -O "$(PDFCMFILE)"
	@echo =
	$(ECHO)	
	
.PHONY : reporter
reporter : 
	$(REPORT) -Raqe $(RESDB) -Pfst $(PROGDB) -O "$(OUTPUTDIR)\IT31023A_Report" -H -M "$(OUTPUTDIR)\IT31023A.map" -F $(CHIPINFO)
	$(ECHO)	
	
