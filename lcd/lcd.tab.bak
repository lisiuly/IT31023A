lcdtab:		.section
;==============================
C_Com0MinByteNum:	.EQU	0			;com0
C_Com1MinByteNum:	.EQU	6			;com1
C_Com2MinByteNum:	.EQU	12			;com2
C_Com3MinByteNum:	.EQU	18			;com3
C_Com4MinByteNum:	.EQU	24			;com4

;lsb
;$2000-------------------------------------
C_Seg0:		.EQU	10000000B			;seg0
C_Seg1:		.EQU	01000000B			;seg1
C_Seg2:		.EQU	00100000B			;seg2
C_Seg3:		.EQU	00010000B			;seg3
C_Seg4:		.EQU	00001000B			;seg4
C_Seg5:		.EQU	00000100B			;seg5
C_Seg6:		.EQU	00000010B			;seg6
C_Seg7:		.EQU	00000001B			;seg7
;$2001---------------------------------------
C_Seg8:			.EQU	10000000B		;seg8
C_Seg9:			.EQU	01000000B		;seg9
C_Seg10:		.EQU	00100000B		;seg10
C_Seg11:		.EQU	00010000B		;seg11
