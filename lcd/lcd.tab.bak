C_Seg17:		.EQU	00000010B		;seg17
C_Seg18:		.EQU	00000100B		;seg18
C_Seg19:		.EQU	00001000B		;seg19
C_Seg20:		.EQU	00010000B		;seg20
C_Seg21:		.EQU	00100000B		;seg21
C_Seg22:		.EQU	01000000B		;seg22
C_Seg23:		.EQU	10000000B		;seg23
;$2003----------------------------------------
