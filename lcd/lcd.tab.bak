;------------------------------
C_NotDispThisDigital:	.EQU	0AH

T_SevenSegCharBitMapTab:
;Dp,G,F,E,D,C,B,A	-->>
;	0,1,2,3,4
	DB	00111111B,00000110B,01011011B,01001111B,01100110B
;	5,6,7,8,9
	DB	01101101B,01111101B,00000111B,01111111B,01101111B
;	No display,'O','N','r','h'
;	a b c d e
	DB	00000000B,00111111B,00110111B,01010000B,01110100B
;   'F','A','-','L','P'
;	f 10 11 12 13
	DB	01110001B,01110111B,01000000B,00111000B,01110011B
;of bf
;on bc
;---
;DotNum:A,B,C,D,E,F,G,Dp
;format:byte index;mask bit、				
T_Digital0DispTab:							;hour  high 主
	DB	07h
	DB	C_Com4MinByteNum+1, C_Seg9 ;adg
	DB	C_Com2MinByteNum+1, C_Seg9 ;b
	DB	C_Com3MinByteNum+1, C_Seg9;c
	DB	C_Com4MinByteNum+6, C_Seg9 ;adg
	DB	C_Com0MinByteNum+1, C_Seg9 ;e
	DB	C_Com4MinByteNum+6, C_Seg9 ;adg
	DB	C_Com4MinByteNum+6, C_Seg9 ;adg
T_Digital0DispTabEnd:
;---
T_Digital1DispTab:							;hour low 主
	DB	07h
	DB	C_Com1MinByteNum+1, C_Seg8 ;a
	DB	C_Com1MinByteNum+0, C_Seg7 ;b
	DB	C_Com3MinByteNum+0, C_Seg7 ;c
	DB	C_Com4MinByteNum+1, C_Seg8 ;d
	DB	C_Com3MinByteNum+1, C_Seg8 ;e
	DB	C_Com2MinByteNum+1, C_Seg8 ;f
	DB	C_Com2MinByteNum+0, C_Seg7 ;g
T_Digital1DispTabEnd:
