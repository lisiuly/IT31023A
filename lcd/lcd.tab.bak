C_Seg25:		.EQU	00000010B		;seg25
C_Seg26:		.EQU	00000100B		;seg26
C_Seg27:		.EQU	00001000B		;seg27
C_Seg28:		.EQU	00010000B		;seg28
C_Seg29:		.EQU	00100000B		;seg29
C_Seg30:		.EQU	01000000B		;seg30
C_Seg31:		.EQU	10000000B		;seg31
;$2004----------------------------------------
C_Seg32:		.EQU	00000001B		;seg32
C_Seg33:		.EQU	00000010B		;seg33
C_Seg34:		.EQU	00000100B		;seg34
C_Seg35:		.EQU	00001000B		;seg35
C_Seg36:		.EQU	00010000B		;seg36
C_Seg37:		.EQU	00100000B		;seg37
C_Seg38:		.EQU	01000000B		;seg38
C_Seg39:		.EQU	10000000B		;seg39
;$2005----------------------------------------
C_Seg40:		.EQU	00000001B		;seg40
C_Seg41:		.EQU	00000010B		;seg41
C_Seg42:		.EQU	00000100B		;seg42
C_Seg43:		.EQU	00001000B		;seg43
