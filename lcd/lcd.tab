T_SevenSegCharBitMapTab:
;Dp,G,F,E,D,C,B,A	-->>
;	0,1,2,3,4
	DB	00111111B,00000110B,01011011B,01001111B,01100110B
;	5,6,7,8,9
	DB	01101101B,01111101B,00000111B,01111111B,01101111B
;	No display,'-','r','L','H'
;	a b c d e
	DB	00000000B,01000000B,01010000B,00111000B,01110110B
	
;;	No display,'O','N','r','h'
;;	a b c d e
;	DB	00000000B,00111111B,00110111B,01010000B,01110100B
;;   'F','A','-','L','P'
;;	f 10 11 12 13
;	DB	01110001B,01110111B,01000000B,00111000B,01110011B
;of bf
;on bc
;---
;DotNum:A,B,C,D,E,F,G,Dp
;format:byte index;mask bit、				
T_Digital0DispTab:							;hour  high 主
	DB	07h
	DB	C_Com1MinByteNum+seg34/8, C_Seg34 ;adg
	DB	C_Com3MinByteNum+seg35/8, C_Seg35 ;b
	DB	C_Com5MinByteNum+seg35/8, C_Seg35 ;c
	DB	C_Com5MinByteNum+seg34/8, C_Seg34 ;adg
	DB	C_Com4MinByteNum+seg34/8, C_Seg34 ;e
	DB	C_Com2MinByteNum+seg34/8, C_Seg34 ;adg
	DB	C_Com3MinByteNum+seg34/8, C_Seg34 ;adg
T_Digital0DispTabEnd:
